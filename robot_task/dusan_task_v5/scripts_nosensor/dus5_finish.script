# =============================================================================
#  dus5_finish.script — dusan_v5
#  벽에서 후퇴하고 완료 플래그를 낸다
#
#  펜던트에서 "10_finish" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def fn_retreat(limit):
  # 벽에서 물러나되 **스캔 대기 위치(Standby_joint)보다 뒤로는 가지 않는다.**
  #   - 기준점은 Standby_joint 의 플랜지 자세(get_forward_kin)다. Standby_pose 변수는
  #     안 쓴다 — 펜던트에 옛 값이 남아 있을 수 있다.
  #   - 지금 자리도 플랜지로 본다. EOAT 끝점 TCP(eoat_ofs)가 남아 있으면 끝점이
  #     245 mm 앞이라 남은 거리가 그만큼 크게 잡혔다. 그래서 먼저 TCP 를 플랜지로.
  #   - 방향은 툴 -Z(벽 법선 반대)다. 호 끝처럼 툴이 돌아가 있어도 벽에서 곧게 뗀다.
  #   - 거리는 limit [m] 과 「대기 위치 X 까지 남은 거리」 중 작은 쪽. 툴 -Z 로 d 만큼
  #     가면 베이스 X 는 d * cz 만큼 준다(cz = 툴 Z 의 베이스 X 성분). 이미 대기
  #     위치보다 뒤면 물러나지 않는다.
  #   - 툴이 벽(+X) 쪽을 보고 있지 않으면(cz <= 0.2, 약 78 도 넘게 돌아감) 벽에
  #     붙은 자세가 아니다 — 엉뚱한 쪽으로 가지 않게 물러나지 않는다.
  set_tcp([0, 0, 0, 0, 0, 0])
  fn_ref = get_forward_kin(Standby_joint)
  fn_cur = get_actual_tool_flange_pose()
  fn_cz = pose_trans(fn_cur, [0, 0, 1, 0, 0, 0])[0] - fn_cur[0]
  fn_back = 0
  if (fn_cz > 0.2):
    fn_back = (fn_cur[0] - fn_ref[0]) / fn_cz
    if (fn_back > limit):
      fn_back = limit
    end
  end
  if (fn_back > 0.001):
    movel(pose_trans(fn_cur, [0, 0, -fn_back, 0, 0, 0]), a = a_l, v = v_l)
  end
end


# ---- 스캔 끝을 먼저 알린다 (마지막 스캔 좌표에서, 물러나기 전) ---------------
# 290 이 6(스캔 중)인 동안은 발행 스레드가 제로점 좌표(280~285)와 호 위치
# (286/287)를 계속 내보낸다. 예전에는 6 인 채로 물러난 뒤에야 5 를 써서, 후퇴
# 경로와 그 뒤 0,0,0 으로 떨어지는 값까지 TPAC 스캔 데이터에 들어갔다
# (2026-10-15). 그래서 여기 마지막 스캔 좌표에서
#   277 = 0  스캔 플래그 끔(DO[1] = 0)
#   290 = 5  스캔 끝 — 발행 스레드가 280~287 을 마지막 스캔 값 그대로 붙잡아
#            둔다(dus5_init 의 pub_rel). 브리지는 리셋(DO[2] = 1)으로 구분한다.
# 을 먼저 쓰고, 브리지가 읽어 TPAC 에 닿을 때까지(sig_hold) 서 있다가 물러난다.
# 완료(290 = 5 · 295 = 1)를 받은 RCS 는 홈 플래그(276)를 본 뒤에야 차량·리프트를
# 움직이므로, 물러나기 전에 써도 된다(예전에도 홈 이동 전에 썼다).
write_port_register(277, 0)
write_port_register(290, 5)
write_port_register(291, row_idx)
write_port_register(295, 1)
write_port_register(298, 100)
sleep(sig_hold)

# 벽에서 물러난다 — 최대 back_off, 스캔 대기 위치보다 뒤로는 안 간다. 예전에는
# 베이스 -X 로 back_off 만큼 무조건 물러나 기준 자세보다 뒤로 갈 수 있었다
# (2026-10-15). 다음 노드(dus5_go_home)가 대기 위치 높이로 올라가 대기 위치를
# 거쳐 홈으로 간다.
fn_retreat(back_off * 0.001)
