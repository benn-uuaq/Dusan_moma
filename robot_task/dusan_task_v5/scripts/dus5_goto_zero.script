# =============================================================================
#  dus5_goto_zero.script — dusan_v5
#  측정이 끝난 뒤 원점(Y- 끝)으로 돌아가 스캔을 시작할 준비를 한다
#
#  펜던트에서 "6_goto_zero" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

# ---- 차량 고정 확인 (309) -------------------------------------------------
# 스캔을 시작하기 전에 차량 쪽이 굳어 있는지 한 번 더 본다. 리프트가 서고,
# 차량이 정지하고, 아웃트리거 고정이 끝나야 RCS 가 309 에 1 을 쓴다.
# 움직이는 중이면 0 이므로 여기서 기다린다(290 = 14). 외부 제어(266 = 1)가
# 아니면 차량이 없는 판이라 그냥 지나간다. dus5_init 의 ini_veh_wait 와
# 같은 규칙이다 — 스크립트 노드마다 따로 돌아서 함수를 다시 둔다.
def gz_veh_wait():
  if (read_port_register(266, True) != 1):
    return True
  end
  gz_vt = 0
  while (read_port_register(309, True) != 1):
    write_port_register(290, 14)
    sync()
    gz_vt = gz_vt + 1
    if (gz_vt > veh_wait_cyc):
      write_port_register(299, 8)
      write_port_register(290, 9)
      halt()
    end
  end
  return True
end


def gz_w1(a, v):
  if (v > 32000):
    v = 32000
  end
  if (v < -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


def gz_w6(a, p):
  gz_w1(a, p[0] * 10000)
  gz_w1(a + 1, p[1] * 10000)
  gz_w1(a + 2, p[2] * 10000)
  gz_w1(a + 3, p[3] * 1000)
  gz_w1(a + 4, p[4] * 1000)
  gz_w1(a + 5, p[5] * 1000)
end


write_port_register(290, 3)

# 현재 TCP 자세를 기준으로 가면 안 된다 — 직전 지점(p_r_pose)의 회전이
# 그대로 남아 있어 zero_pose 의 회전과 다르고, 그 채로(베이스 좌표축을
# 하나씩 맞추며) 위치만 옮기면 정면을 본 자세로 볼록한 곡면을 파고들며
# 접근하다가 마지막에 Rz 를 한 번에 먹여 그리퍼가 벽을 쓸고 지나간다.
# probe_l/r 과 같은 방식으로, zero_pose 자세 그대로 **TCP 기준** +Z 반대
# 방향(로컬 -Z)으로 물러난 지점까지 먼저 이동한 뒤, 그 자세 그대로
# 로컬 +Z 로 전진해 들어간다 — 베이스 축을 하나씩 맞추는 방식이 아니다.
#
# 지금 로봇은 dus5_probe_r 이 끝낸 자리(Y+ 끝)에 있고 z_stand 는 호 반대쪽
# (원점, Y- 끝) 이라 호 전체 폭만큼 자세가 크게 돌아간다. 한때
# movej(get_inverse_kin(...))로 바꿨었는데, 좌우 이동은 movel(직선)로
# 가도록 되돌린다.
z_stand = pose_trans(zero_pose, [0, 0, -probe_dist * 0.001, 0, 0, 0])
movel(z_stand, a = a_l, v = v_l)
# z_stand -> zero_pose 도 probe_dist 만큼밖에 안 되는 짧은 이동이지만,
# 막 큰 자세 변화(movej)를 거친 직후라 그 근처는 여전히 movel 의 직선
# 경로 역기구학이 빡빡할 수 있다(dus5_probe_r.script 에서 실제로 발생).
# zero_pose 는 이미 probe_l.script 에서 눌림 센서로 확인해 둔 자리라
# 여기서는 계산값으로 바로 들어가는 것뿐이라 직선일 필요가 없다 —
# movel 대신 movej 를 쓴다.
movej(get_inverse_kin(zero_pose), a = a_j, v = v_j / 3.0)  # 접촉 위치 진입: 천천히

gz_w6(270, zero_pose)      # 원점 pose (스캔 중 변하지 않는다)
write_port_register(294, 1)
path_len = 0

# ---- 원점 도착 : ERUT 확인 대기 -------------------------------------------
# 프로브가 벽에 제대로 붙었는지는 여기서 판단할 수 없다(눌림 센서는 접촉
# 여부만 안다). 원점에 도착했다고 알린 뒤(290 = 7) 멈춰 서서, RCS 가
# 267 에 1 을 써 줄 때까지 기다린다. RCS 는 290 이 7 이 되는 걸 보고
# MQTT 로 도착을 알리고, ERUT 가 "작업 시작"을 보내면 267 을 세운다.
#
# 267 은 기다리기 **전에** 우리가 0 으로 지운다 — 지난 사이클에 남은
# 허가가 그대로 있으면 확인 없이 통과해 버린다(루프판에서 실제로 문제).
write_port_register(267, 0)
write_port_register(290, 7)
while (read_port_register(267, True) != 1):
  sync()
end
write_port_register(267, 0)

# 차량·리프트가 굳어 있어야 스캔에 들어간다(아웃트리거 고정 전에 팔을
# 뻗으면 차량이 흔들린다).
gz_veh_wait()

# ---- 적심(비비기) ---------------------------------------------------------
# 스캔 전에 검사면에 물을 퍼뜨린다. 원점에서 호 **안쪽**으로 조금 갔다가
# 돌아오기를 wet_cycles 번 반복한다.
#
# 방향은 **툴 로컬 X** 다. 프로브는 로컬 +Z 로 벽에 다가가므로(probe_*
# 스크립트가 전부 [0, 0, +-d] 로 전진·후퇴한다) 로컬 X/Y 는 벽면을 따라
# 미끄러지는 축이고, 그중 X 가 호(좌우) 방향, Y 가 상하다. 베이스 Y 로
# 밀면 안 된다 — 원점에서는 호가 arc_half 만큼 돌아 있어 그만큼 벽을
# 파고들거나 뜬다.
#
# 부호는 호 중앙(p_c_pose)이 로컬에서 어느 쪽에 있는지로 정한다. 원점
# 바깥으로는 나가지 않는다 — 작업 영역 끝이라 벽이 거기서 끝날 수 있다.
# 10mm 를 직선으로 가도 곡면에서 벗어나는 양은 10^2/(2R) = 0.06mm 라
# 무시할 수 있다.
write_port_register(290, 8)
# TODO: 여기에 물 분사 켜기를 넣는다. 비비기 전에 켜고 끝나면 끈다.
#       (밸브 출력 배정되면 set_standard_digital_out(n, True/False) 로)
wet_ref = pose_trans(pose_inv(zero_pose), p_c_pose)
wet_step = wet_amp
if (wet_ref[0] < 0):
  wet_step = -wet_amp
end
wet_i = 0
while (wet_i < wet_cycles):
  movel(pose_trans(zero_pose, [wet_step * 0.001, 0, 0, 0, 0, 0]),
        a = a_scan, v = v_scan)
  movel(zero_pose, a = a_scan, v = v_scan)
  wet_i = wet_i + 1
end
# TODO: 여기서 물 분사 끄기.

# 여기서부터 스캔 구간이다 — 호를 그리는 패스뿐 아니라 줄을 바꾸는
# 상승(dus5_up)까지 포함한다. 이 구간에서만 제로점 기준 좌표(280~285)가
# 살아 있고(dus5_init 의 pub_rel), RCS 도 state=6 으로 스캔 중을 안다.
write_port_register(290, 6)
