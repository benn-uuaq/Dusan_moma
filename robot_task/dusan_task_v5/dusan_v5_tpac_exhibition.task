                <cachedFileContents># =============================================================================
#  dus5_pass_l.script — dusan_v5 (tpac_exhibition)
#
#  전시판(시편을 바닥에 눕힘, 볼록면이 위). 논센서판과 같고, 호를 베이스가
#  아니라 **작업 좌표계**(dus5_init 의 「바닥판 작업 좌표계」)에서 그린다 —
#  곡률 중심(arc_ox, arc_oy)이 그 좌표계 값이고, 회전축은 작업 Z(= 베이스 +X,
#  곡면의 축)다. 로봇에 주는 목표만 베이스로 되돌린다.
#  반대쪽 끝에서 원점으로 한 줄. servoj 로 호를 따라가며 눌림을 계속 확인한다
#
#  펜던트에서 "8_pass_left" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  [논센서판] 접촉 센서가 없는 시험용이다. v5 의 servoj 호 경로는 센서판과
#  같지만 **눌림 보정은 하지 않는다**(288 = 0 그대로). 경로·속도·역기구학을
#  센서 없이 먼저 확인하는 용도다.
#
#  호는 dus5_probe_l 이 잡은 곡률 중심(arc_ox, arc_oy)을 지나는 **작업 Z 축**
#  둘레의 회전이다(al_arc 와 같은 방식) — 자세도 같이 돌아 손이 늘 그
#  자리의 법선을 본다. 작업 Z(줄 위치, 베이스 X)는 그대로다.
# =============================================================================

def nl_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


def nl_wrap(a):
  if (a &gt; 3.14159265):
    a = a - 6.28318531
  end
  if (a &lt; -3.14159265):
    a = a + 6.28318531
  end
  return a
end


def nl_to_w(p):
  # 베이스 -&gt; 작업 좌표계(베이스를 Y 축으로 +90 도). dus5_init 의 ini_to_w 와 같다.
  return pose_trans(pose_inv([0, 0, 0, 0, 1.57079633, 0]), p)
end


def nl_to_b(p):
  # 작업 좌표계 -&gt; 베이스.
  return pose_trans([0, 0, 0, 0, 1.57079633, 0], p)
end


def nl_rot(o_t, rel, phi):
  # 곡률 중심 o_t 를 지나는 작업 Z 축으로 rel 을 phi [rad] 만큼 돌린 자세(작업 좌표계).
  return pose_trans(o_t, pose_trans([0, 0, 0, 0, 0, phi], rel))
end


def nl_fail(code, msg):
  stopj(2.0)
  write_port_register(288, 0)
  write_port_register(299, code)
  write_port_register(290, 9)
  popup(s = msg, title = "dusan_v5", blocking = True)
  halt()
end


def nl_servo_arc(end_pose):
  # 지금 자세에서 end_pose 의 방위각까지 호를 그린다. 반환: 호 길이 [mm].
  # 곡률 중심이 안 잡혔으면(dus5_probe_l 실패·반지름 0) 지난 사이클 값으로
  # 엉뚱한 호를 그리게 된다. 그리지 않고 멈춘다.
  if (arc_ok == False):
    nl_fail(4, "SCAN ARC: NO ARC CENTER (radius 260 / arc 256)")
  end
  # 계산은 전부 작업 좌표계에서 한다(p0w · end_w · o_t · rel). 베이스로 되돌리는
  # 건 역기구학에 넣는 목표뿐이다.
  p0 = get_actual_tcp_pose()
  p0w = nl_to_w(p0)
  end_w = nl_to_w(end_pose)
  o_t = [arc_ox, arc_oy, 0, 0, 0, 0]
  rel = pose_trans(pose_inv(o_t), p0w)
  rx = p0w[0] - arc_ox
  ry = p0w[1] - arc_oy
  r_path = sqrt(rx * rx + ry * ry)
  dphi = nl_wrap(atan2(end_w[1] - arc_oy, end_w[0] - arc_ox) - atan2(ry, rx))
  sgn = 1
  if (dphi &lt; 0):
    sgn = -1
  end
  sv_tot = dphi * sgn * r_path

  # 가는 길에 역기구학 해가 없으면 도중에 알람으로 서 버린다. 미리 본다.
  sv_q = get_actual_joint_positions()
  p_mid = nl_to_b(nl_rot(o_t, rel, dphi * 0.5))
  p_end = nl_to_b(nl_rot(o_t, rel, dphi))
  if (get_inverse_kin_has_solution(p_mid, qnear = sv_q) == False or get_inverse_kin_has_solution(p_end, qnear = sv_q) == False):
    nl_fail(7, "SCAN ARC: NO IK SOLUTION")
  end

  sv_s = 0
  sv_v = 0
  sv_set = 0
  # 끝점에 닿은 뒤에도 lookahead 만큼 따라오는 중이다. 두 배를 기다린다.
  sv_nset = ceil(sv_look * 2.0 / sv_dt)
  # 진행량은 **실제로 흐른 시간**으로 계산한다. servoj(t = sv_dt) 는 최소
  # sv_dt 만큼 막히지만, 컨트롤러 주기가 더 길거나(예: 8 ms) 루프 안의
  # 역기구학·센서·레지스터 일이 더해지면 한 바퀴가 sv_dt 보다 길어진다.
  # 그런데도 sv_dt 만큼씩만 전진시키면 목표점이 그만큼 늦게 나가 실제
  # 속도가 v_scan 보다 한참 느려진다. 컨트롤러 시각(controller_timestamp)
  # 으로 한 바퀴 걸린 시간을 재서 쓴다. 값이 이상하면(0 이하·50 ms 초과)
  # 예전처럼 sv_dt 를 쓴다.
  # 속도 비율(307, %)은 **이 호에만 여기서 건다.** movel·movej 는 컨트롤러가
  # 비율(펜던트 슬라이더 = RCS 의 29999 'speed -v N')로 줄여 주지만, servoj 는
  # 매 주기 위치를 우리가 직접 찍어 보내는 것이라 비율이 걸리지 않는다 — 그래서
  # 비율 15 % 에서 다른 동작은 15 mm/s 인데 스캔 좌우만 100 mm/s 로 돌았다
  # (2026-10-14). RCS 는 비율을 바꿀 때 307 에도 같이 써 둔다.
  # 전역 v_scan 에 곱하지 않고 이 호의 지역값(sv_vmax)만 쓴다 — 셀마다 다시
  # 곱해져 계속 줄어들던 예전 문제(dus5_init ※)를 되풀이하지 않게.
  # 307 이 비었거나(0) 2~100 밖이면 100 % 로 본다.
  sv_ratio = read_port_register(307, True)
  if (sv_ratio &lt; 2 or sv_ratio &gt; 100):
    sv_ratio = 100
  end
  sv_vmax = v_scan * sv_ratio / 100.0
  sv_tp = controller_timestamp()
  while (sv_set &lt; sv_nset):
    sv_tn = controller_timestamp()
    sv_h = sv_tn - sv_tp
    sv_tp = sv_tn
    if (sv_h &lt;= 0 or sv_h &gt; 0.05):
      sv_h = sv_dt
    end
    # 1) 진행 — 사다리꼴 속도(a_scan, sv_vmax). 남은 거리로 감속한다.
    if (sv_s &lt; sv_tot):
      v_top = sqrt(2.0 * a_scan * (sv_tot - sv_s))
      if (v_top &gt; sv_vmax):
        v_top = sv_vmax
      end
      if (v_top &lt; 0.002):
        v_top = 0.002
      end
      sv_v = sv_v + a_scan * sv_h
      if (sv_v &gt; v_top):
        sv_v = v_top
      end
      sv_s = sv_s + sv_v * sv_h
      if (sv_tot - sv_s &lt; 0.0002):
        sv_s = sv_tot
      end
    else:
      sv_set = sv_set + 1
    end

    # 3) 목표 자세 -&gt; 관절 -&gt; servoj (sv_dt 동안 막힌다 = 루프 주기)
    tgt = nl_to_b(nl_rot(o_t, rel, sgn * sv_s / r_path))
    sv_q = get_inverse_kin(tgt, qnear = sv_q)
    servoj(sv_q, t = sv_dt, lookahead_time = sv_look, gain = sv_gain)
  end
  stopj(2.0)
  write_port_register(288, 0)
  # 로봇은 플랜지 기준으로 v_scan 으로 돌지만, 기록할 길이(297·287)는 **프로브 중심이
  # 벽 위로 지난 호**다 — 같은 각도를 프로브 중심 반지름으로 곱한다.
  tp = pose_trans(p0w, eoat_ofs)
  r_tip = sqrt((tp[0] - arc_ox) * (tp[0] - arc_ox) + (tp[1] - arc_oy) * (tp[1] - arc_oy))
  return dphi * sgn * r_tip * 1000.0
end


# p_r_pose 쪽 끝 -&gt; 원점(zero_pose) 방위각까지 한 줄.
# 반시계 방향이라 베이스 Y 는 **늘어나는** 쪽이다.
# 스캔 동작에 들어섰다고 알린다(6 = 스캔 중). 이 값이 6 인 동안에만
# 제로점 기준 좌표(280~285)가 나간다 — dus5_init 의 pub_rel 참고.
write_port_register(290, 6)

# ---- TPAC 동기 신호 --------------------------------------------------------
# 277 = 지금 도는 스캔 구간. RCS 브리지가 이 값을 TPAC 엔코더 보드의 DO 신호
# (Coil 16~18 / Reg 1)로 바꿔 보낸다 — 1 전진 스캔, 2 줄 바꿈(동결), 3 후진 스캔.
# 브리지가 값을 읽고(100 ms 주기) 방향 -&gt; 스캔 순서로 신호를 50 ms 이상씩
# 붙잡아 둘 시간을 주고 나서 움직인다(sig_hold). 안 기다리면 줄 앞부분이
# 펄스 없이 지나가 TPAC 이 그만큼을 못 센다.
write_port_register(277, 3)
sleep(sig_hold)
pass_len = nl_servo_arc(zero_pose)
# 끝점 도착 — 스캔 동결(277 = 0 -&gt; DO[1] = 0). 동결이 TPAC 에 닿은 뒤에
# 다음 동작(줄 바꿈 상승)으로 간다.
write_port_register(277, 0)
sleep(sig_hold)

row_idx = row_idx + 1
dir_sign = 1
pass_done = 1
# 총 작업 거리는 TCP 가 실제로 지난 호 길이다(pass_len, mm).
path_len = path_len + pass_len
write_port_register(291, row_idx)
nl_w1(297, path_len * 0.1)
nl_w1(298, row_idx * 100.0 / rows)
</cachedFileContents>
