          <children>
            <FolderNode display="10 [스크립트파일] dus5_finish.script" isHideSubtree="false" typeName="폴더">
              <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
                <cachedFileContents># =============================================================================
#  dus5_finish.script — dusan_v5 (tpac_exhibition)
#  판에서 후퇴하고 완료 플래그를 낸다
#
#  전시판(시편을 바닥에 눕힘). 원 태스크의 「벽 쪽 = 베이스 +X」가 여기서는 작업 X,
#  곧 베이스 **-Z(아래, 판 쪽)** 다 — dus5_init 의 「바닥판 작업 좌표계」. 그래서
#  「대기 위치 X 보다 뒤로 안 간다」가 「대기 위치 **높이**보다 위로 안 간다」가 된다.
#
#  펜던트에서 "10_finish" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def fn_to_w(p):
  # 베이스 -&gt; 작업 좌표계(베이스를 Y 축으로 +90 도). dus5_init 의 ini_to_w 와 같다.
  return pose_trans(pose_inv([0, 0, 0, 0, 1.57079633, 0]), p)
end


def fn_retreat(limit):
  # 벽에서 물러나되 **스캔 대기 위치(Standby_joint)보다 뒤로는 가지 않는다.**
  #   - 기준점은 Standby_joint 의 플랜지 자세(get_forward_kin)다. Standby_pose 변수는
  #     안 쓴다 — 펜던트에 옛 값이 남아 있을 수 있다.
  #   - 지금 자리도 플랜지로 본다. EOAT 끝점 TCP(eoat_ofs)가 남아 있으면 끝점이
  #     245 mm 앞이라 남은 거리가 그만큼 크게 잡혔다. 그래서 먼저 TCP 를 플랜지로.
  #   - 방향은 툴 -Z(벽 법선 반대)다. 호 끝처럼 툴이 돌아가 있어도 벽에서 곧게 뗀다.
  #   - 거리는 limit [m] 과 「대기 위치 X 까지 남은 거리」 중 작은 쪽. 툴 -Z 로 d 만큼
  #     가면 베이스 X 는 d * cz 만큼 준다(cz = 툴 Z 의 베이스 X 성분). 이미 대기
  #     위치보다 뒤면 물러나지 않는다.
  #   - 툴이 벽(+X) 쪽을 보고 있지 않으면(cz &lt;= 0.2, 약 78 도 넘게 돌아감) 벽에
  #     붙은 자세가 아니다 — 엉뚱한 쪽으로 가지 않게 물러나지 않는다.
  #   - (전시판) 위 「베이스 X」는 모두 작업 X(= 베이스 -Z)로 읽는다: 대기 위치
  #     높이까지 남은 만큼, 툴이 아래(판)를 보고 있을 때만 위로 뗀다.
  set_tcp([0, 0, 0, 0, 0, 0])
  fn_ref = fn_to_w(get_forward_kin(Standby_joint))
  fn_base = get_actual_tool_flange_pose()
  fn_cur = fn_to_w(fn_base)
  fn_cz = pose_trans(fn_cur, [0, 0, 1, 0, 0, 0])[0] - fn_cur[0]
  fn_back = 0
  if (fn_cz &gt; 0.2):
    fn_back = (fn_cur[0] - fn_ref[0]) / fn_cz
    if (fn_back &gt; limit):
      fn_back = limit
    end
  end
  if (fn_back &gt; 0.001):
    movel(pose_trans(fn_base, [0, 0, -fn_back, 0, 0, 0]), a = a_l, v = v_l)
  end
end


# ---- 스캔 끝을 먼저 알린다 (마지막 스캔 좌표에서, 물러나기 전) ---------------
# 290 이 6(스캔 중)인 동안은 발행 스레드가 제로점 좌표(280~285)와 호 위치
# (286/287)를 계속 내보낸다. 예전에는 6 인 채로 물러난 뒤에야 5 를 써서, 후퇴
# 경로와 그 뒤 0,0,0 으로 떨어지는 값까지 TPAC 스캔 데이터에 들어갔다
# (2026-10-15). 그래서 여기 마지막 스캔 좌표에서
#   277 = 0  스캔 플래그 끔(DO[1] = 0)
#   290 = 5  스캔 끝 — 발행 스레드가 280~287 을 마지막 스캔 값 그대로 붙잡아
#            둔다(dus5_init 의 pub_rel). 브리지는 리셋(DO[2] = 1)으로 구분한다.
# 을 먼저 쓰고, 브리지가 읽어 TPAC 에 닿을 때까지(sig_hold) 서 있다가 물러난다.
# 완료(290 = 5 · 295 = 1)를 받은 RCS 는 홈 플래그(276)를 본 뒤에야 차량·리프트를
# 움직이므로, 물러나기 전에 써도 된다(예전에도 홈 이동 전에 썼다).
write_port_register(277, 0)
write_port_register(290, 5)
write_port_register(291, row_idx)
write_port_register(295, 1)
write_port_register(298, 100)
sleep(sig_hold)

# 벽에서 물러난다 — 최대 back_off, 스캔 대기 위치보다 뒤로는 안 간다. 예전에는
# 베이스 -X 로 back_off 만큼 무조건 물러나 기준 자세보다 뒤로 갈 수 있었다
# (2026-10-15). 다음 노드(dus5_go_home)가 남은 만큼 대기 위치 X 까지 물러나고
# 높이를 대기 위치에 맞춘(올리거나 내림) 뒤 대기 위치를 거쳐 홈으로 간다.
fn_retreat(back_off * 0.001)
</cachedFileContents>
                <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts_tpac_exhibition/dus5_finish.script"/>
              </ScriptNode>
            </FolderNode>
            <FolderNode display="11 [스크립트파일] dus5_go_home.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_go_home.script — dusan_v5 (tpac_exhibition)
#
#  전시판(시편을 바닥에 눕힘). 대기 위치 「선상」 맞추기를 작업 좌표계(dus5_init 의
#  「바닥판 작업 좌표계」)에서 한다 — 원 태스크의 「베이스 X(벽 쪽)」는 작업 X =
#  베이스 -Z(아래), 「높이(베이스 Z)」는 작업 Z = 베이스 +X(줄 진행)다. 그래서
#    1) 대기 위치보다 낮으면 먼저 **곧게 위로** 대기 위치 높이까지 올라가고,
#    2) 그 높이에서 **베이스 X 만** 대기 위치에 맞춘 뒤(앞뒤로),
#  movej 로 대기 위치에 간다.
#  스캔을 마친 뒤 스캔 대기 위치를 거쳐 홈으로 간다 (작업 끝)
#
#  펜던트에서 스캔 태스크 마지막 "move_home" 자리(dus5_finish 다음)에 스크립트
#  노드를 파일(File) 모드로 넣고 지정한다. 벽에서 물러나는 것은 바로 앞의
#  dus5_finish 가 이미 했다(대기 위치 기준, 최대 back_off).
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  홈과 작업 자리 사이는 **언제나 스캔 대기 위치를 거친다**(2026-10-15):
#    시작 : 홈 --movej--&gt; 스캔 대기 위치 --&gt; 시작 위치(start_pose)
#    끝   : 스캔 완료 자리 --&gt; (대기 위치 기준) 물러나고 --&gt; 대기 위치 선상(X · 높이)에
#           맞추고 --movej--&gt; 스캔 대기 위치 --movej--&gt; 홈
#  스캔 대기 위치(Standby_joint) = 예전의 「홈」. RCS 「스캔 대기 위치 저장」(레지스터
#  310~315, 308 = 1) 또는 펜던트 변수. 홈(Home_joint)은 RCS 「홈 위치 저장」(레지스터
#  322~327, 328 = 1) 또는 펜던트에서 티칭한 변수(dus5_init 참고).
#
#  완료 표시(290 = 5)는 dus5_finish 가 이미 냈다 — 여기서는 상태 레지스터를
#  건드리지 않는다. 홈에 닿았는지는 발행 스레드가 276 으로 알린다.
# =============================================================================

def gh_to_w(p):
  # 베이스 -&gt; 작업 좌표계(베이스를 Y 축으로 +90 도). dus5_init 의 ini_to_w 와 같다.
  return pose_trans(pose_inv([0, 0, 0, 0, 1.57079633, 0]), p)
end


def gh_to_b(p):
  # 작업 좌표계 -&gt; 베이스.
  return pose_trans([0, 0, 0, 0, 1.57079633, 0], p)
end


def gh_align():
  # 스캔 대기 위치 **선상**에 맞춘다(플랜지 기준, 2026-10-16):
  #   1) 아직 대기 위치보다 앞(베이스 +X, 벽 쪽)이면 베이스 -X 로 곧게 물러나
  #      대기 위치 X 에 선다. 벽에서는 앞 동작(_retreat · dus5_finish)이 이미
  #      툴 -Z 로 떨어졌다 — 여기서는 남은 만큼 뒤로만 간다.
  #   2) 높이(베이스 Z)를 대기 위치 높이로 **올리거나 내린다.** 위 줄에서 끝나
  #      대기 위치보다 높으면 내려온다(예전에는 올라가기만 했다).
  # Y 와 자세는 그대로 둔다 — 남은 것은 다음 movej(대기 위치)가 맞춘다.
  # 이미 대기 위치보다 뒤에 있으면 앞으로 나가지 않는다.
  set_tcp([0, 0, 0, 0, 0, 0])
  # (전시판) 아래 [0] · [2] 는 작업 좌표계 값이다 — [0] 이 클수록 낮다(판 쪽),
  # [2] 는 베이스 X(줄 진행)다.
  ga_ref = gh_to_w(get_forward_kin(Standby_joint))
  ga_p = gh_to_w(get_actual_tool_flange_pose())
  if (ga_p[0] &gt; ga_ref[0] + 0.001):
    ga_p[0] = ga_ref[0]
    movel(gh_to_b(ga_p), a = a_l, v = v_l)
  end
  ga_p = gh_to_w(get_actual_tool_flange_pose())
  if (ga_p[2] &lt; ga_ref[2] - 0.001 or ga_p[2] &gt; ga_ref[2] + 0.001):
    ga_p[2] = ga_ref[2]
    movel(gh_to_b(ga_p), a = a_l, v = v_l)
  end
end


gh_align()
movej(Standby_joint, a = a_j, v = v_j)
movej(Home_joint, a = a_j, v = v_j)
