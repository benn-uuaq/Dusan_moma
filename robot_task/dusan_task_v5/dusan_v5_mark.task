    <FolderNode display="3 move_start" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_move_start.script — dusan_v5
#  각 프로브 동작 사이의 대기 자세로 이동한다 (Home_joint 이 아니라 start_pose)
#
#  펜던트에서 "2 move_home" 다음 자리(각 프로브 동작 앞)에 스크립트 노드를
#  파일(File) 모드로 넣고 지정한다. 펜던트의 Move/Waypoint 노드를 쓰지 않고
#  스크립트로 두는 이유는, 티칭 값이 태스크 XML 안에 숨지 않고 설정 변수
#  (start_pose, a_l, v_l, r_l)로 한곳에 모이기 때문이다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  start_pose 는 로봇 툴플렌지 기준이 아니라 실제 장착된 그리퍼(5축/8축)
#  기준으로 맞춰지도록 dus5_init.script 가 매 작업마다 계산해 둔 값이다
#  (eoat_type + eoat5/8_offset_x/y/z 참고). 여기서는 그 결과만 쓴다.
#
#  move_home 과 같은 이유로 두 단계로 나눈다: 먼저 현재 위치에서 Z 만
#  start_pose 높이까지 올린 뒤(자세는 그대로 두고 벽/바닥을 스치지
#  않게), 그다음 start_pose 자세로 재배치한다. 좌우 이동은 movel(직선)로
#  가도록 한다.
#
#  이 판은 **블렌드 없이** 정확히 start_pose 에 선다. 홈에서 처음 들어올
#  때와 probe_c 로 넘어갈 때처럼, 다음 동작이 접촉 탐색이라 시작점이
#  흔들리면 안 되는 자리에 쓴다. 블렌드가 필요한 자리는
#  dus5_move_start_waypoint.script 를 쓴다.
if (get_actual_tcp_pose()[2] &lt; start_pose[2] - 0.001):
  z_up = get_actual_tcp_pose()
  z_up[2] = start_pose[2]
  movel(z_up, a = a_l, v = v_l)
end
movel(start_pose, a = a_l, v = v_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_move_start.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="4 [스크립트파일] dus5_probe_c.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_probe_c.script — dusan_v5
#  호 중앙에서 벽을 짚어 '적정 눌림' 위치를 캘리브레이션한다
#
#  펜던트에서 "3_probe_center" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  센서는 손 **중앙에 하나**다. 좌우 막대 두 개로 기울기를 재던 방식은 없앴다.
#    di_touch : 적정 눌림 (OK)
#    di_limit : 눌림 한계 (뒤로 빼야 함)
#  하나뿐이라 기울기(Rz)는 잴 수 없다. 자세는 호 기하로 계산하고, 센서는
#  **얼마나 깊이 밀어야 하는지**(press_off) 하나만 잡아 준다.
#
#  전진/후진은 베이스가 아니라 **TCP 기준**이다 — 호를 그리며 도는 동안
#  손의 방향이 계속 바뀌기 때문이다.
#    TCP +Z = 전진(벽 쪽)   /   TCP -Z = 후진
# =============================================================================

def pc_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


# 로봇 자체 레지스터 384~389 와 같은 단위.  길이 0.1mm, 회전 mRad
def pc_w6(a, p):
  pc_w1(a, p[0] * 10000)
  pc_w1(a + 1, p[1] * 10000)
  pc_w1(a + 2, p[2] * 10000)
  pc_w1(a + 3, p[3] * 1000)
  pc_w1(a + 4, p[4] * 1000)
  pc_w1(a + 5, p[5] * 1000)
end


def pc_step(dmm):
  # TCP 기준 Z 로 dmm [mm] 만큼 움직인다. 음수가 전진(벽 쪽) — dmm 부호의
  # 의미는 예전(Y축) 그대로 두고, 축만 Y에서 Z로 바꾼다(그래서 부호가
  # 한 번 뒤집힌다: 예전 [0,dmm,0,0,0,0] -&gt; 이제 [0,0,-dmm,0,0,0]).
  movel(pose_trans(get_actual_tcp_pose(), [0, 0, -dmm * 0.001, 0, 0, 0]),
     a = a_l, v = v_l / 3.0)  # 접촉 탐색: 천천히
end


def pc_rush(t):
  movel(t, a = a_l, v = v_l / 3.0)  # 접촉 탐색: 천천히
end


def pc_press():
  # 벽에 닿아 '적정 눌림'이 될 때까지 TCP +Z 로 전진한다.
  # 반환: 전진한 거리 [m] (양수). 못 찾으면 0.
  # n_hit 는 preamble 전역이라, 이 함수 안에서 대입하려면 global 로
  # 밝혀 둬야 한다 — 안 그러면 지역변수로 가려져 "초기화 안 됨" 에러가 난다.
  global n_hit
  x_home = get_actual_tcp_pose()
  far = pose_trans(x_home, [0, 0, seek_limit * 0.001, 0, 0, 0])

  # 끊김 없이 한 번에 보내 놓고, 센서가 걸리는 순간 세운다.
  mv_h = start_thread(pc_rush, (far,), detach_mode = False)
  while (True):
    if (get_standard_digital_in(di_touch) or get_standard_digital_in(di_limit)):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    if (pose_dist(get_actual_tcp_pose(), far) &lt; 0.0005):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    sync()
  end

  # 한계까지 들어갔으면 적정 눌림만 남을 때까지 뒤로(-Z) 뺀다.
  tries = 0
  while (get_standard_digital_in(di_limit) and tries &lt; seek_tries):
    tries = tries + 1
    pc_step(seek_step)
    sync()
  end

  # 아직 안 닿았으면 적정 눌림이 될 때까지 조금씩 더 민다.
  tries = 0
  while (get_standard_digital_in(di_touch) == False and tries &lt; seek_tries):
    tries = tries + 1
    pc_step(-seek_step)
    sync()
  end

  if (get_standard_digital_in(di_touch)):
    n_hit = n_hit + 1
    return pose_dist(x_home, get_actual_tcp_pose())
  end
  # 계산값 대신 쓸 값이 없다 — 여기서 조용히 넘어가면 잘못된 좌표로
  # 스캔을 시작하게 되므로, 실패는 반드시 멈춰서 알려야 한다.
  popup(s = "PROBE_C: WALL CONTACT NOT FOUND", title = "dusan_v5", blocking = True)
  write_port_register(299, 1)
  write_port_register(290, 9)
  halt()
  return 0
end


write_port_register(290, 2)
y_c = get_actual_tcp_pose()[1]
z_base = get_actual_tcp_pose()[2]

# 아직 한 번도 돌리지 않은 지금 자세를 '정위치'로 기억해 둔다.
probe_rot = get_actual_tcp_pose()

# 중앙 접근 — 여기서 잰 깊이가 세 점 전체에 쓰인다.
x_start = get_actual_tcp_pose()
press_off = pc_press()

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)
pc_w1(303, press_off * 10000)

# 호의 중앙점. 회전값까지 통째로 남긴다(곡률 중심을 여기서 잡는다).
p_c_pose = get_actual_tcp_pose()
p_cx = p_c_pose[0]
write_port_register(300, floor(p_cx * 10000 + 0.5))
pc_w6(330, p_c_pose)

# 벽에서 물러난다 (TCP -Z). 잰 깊이만큼만 되돌리면 제자리다.
movel(x_start, a = a_l, v = v_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_probe_c.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="5 move_start" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_move_start.script — dusan_v5
#  각 프로브 동작 사이의 대기 자세로 이동한다 (Home_joint 이 아니라 start_pose)
#
#  펜던트에서 "2 move_home" 다음 자리(각 프로브 동작 앞)에 스크립트 노드를
#  파일(File) 모드로 넣고 지정한다. 펜던트의 Move/Waypoint 노드를 쓰지 않고
#  스크립트로 두는 이유는, 티칭 값이 태스크 XML 안에 숨지 않고 설정 변수
#  (start_pose, a_l, v_l, r_l)로 한곳에 모이기 때문이다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  start_pose 는 로봇 툴플렌지 기준이 아니라 실제 장착된 그리퍼(5축/8축)
#  기준으로 맞춰지도록 dus5_init.script 가 매 작업마다 계산해 둔 값이다
#  (eoat_type + eoat5/8_offset_x/y/z 참고). 여기서는 그 결과만 쓴다.
#
#  move_home 과 같은 이유로 두 단계로 나눈다: 먼저 현재 위치에서 Z 만
#  start_pose 높이까지 올린 뒤(자세는 그대로 두고 벽/바닥을 스치지
#  않게), 그다음 start_pose 자세로 재배치한다. 좌우 이동은 movel(직선)로
#  가도록 한다.
#
#  이 판은 **블렌드 없이** 정확히 start_pose 에 선다. 홈에서 처음 들어올
#  때와 probe_c 로 넘어갈 때처럼, 다음 동작이 접촉 탐색이라 시작점이
#  흔들리면 안 되는 자리에 쓴다. 블렌드가 필요한 자리는
#  dus5_move_start_waypoint.script 를 쓴다.
if (get_actual_tcp_pose()[2] &lt; start_pose[2] - 0.001):
  z_up = get_actual_tcp_pose()
  z_up[2] = start_pose[2]
  movel(z_up, a = a_l, v = v_l)
end
movel(start_pose, a = a_l, v = v_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_move_start.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="6 [스크립트파일] dus5_probe_l.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_probe_l.script — dusan_v5
#  호의 양 끝점을 반지름·호각으로 **먼저 계산**하고, 원점(이 중 Y- 끝)은
#  그 계산값으로 접근해 실제 벽 접촉으로 다시 보정한다.
#
#  펜던트에서 "4_probe_left" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  센서가 중앙 하나뿐이라 계산만으로 끝내면, 도면 반지름이 실제 벽과 조금만
#  달라도(또는 벽이 완전한 원통이 아니어도) 원점이 벽에서 뜨거나 파고든다.
#  그래서 계산값은 "여기쯤일 것이다"라는 접근 목표로만 쓰고, 그 자리에 가서
#  중앙과 똑같이 눌림 센서로 다시 찾는다 — probe_c 의 pc_press() 와 같은
#  방식이다. Y- 끝(p_r_pose)은 여기서는 계산만 해 두고, dus5_probe_r.script가
#  같은 방식으로 실측한다.
#
#  기하: 중앙 접점 P 에서 TCP +Z 로 R 만큼 간 곳이 곡률 중심 O 다
#  (바깥 볼록면을 훑으므로 중심은 벽 뒤에 있다). O 를 베이스 Z 로 t 만큼 돌린 뒤
#  다시 로컬 -Z 로 R 만큼 나오면 호 위의 점이 되고, **손 방향도 그 점의
#  법선으로 같이 돌아간다** — servoj 호에 그대로 쓸 수 있는 자세다.
# =============================================================================

def al_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


def al_w6(a, p):
  al_w1(a, p[0] * 10000)
  al_w1(a + 1, p[1] * 10000)
  al_w1(a + 2, p[2] * 10000)
  al_w1(a + 3, p[3] * 1000)
  al_w1(a + 4, p[4] * 1000)
  al_w1(a + 5, p[5] * 1000)
end


def al_arc(mid, th):
  # 중앙 접점 mid 에서 호를 따라 th [rad] 만큼 돌아간 점(자세 포함).
  #
  # 원통은 세워져 있으므로 호는 **수평면** 안에 있다. 그래서
  #   (1) 곡률 중심 O 는 접점에서 '전진 방향(TCP +Z)의 **수평 성분**'으로 R.
  #       TCP +Z 가 조금 기울어 있어도 수평 성분만 써야 반지름이 맞는다.
  #   (2) 회전은 O 를 지나는 **수직축(베이스 Z)** 으로 한다.
  #       툴 로컬 Z 로 돌리면 호가 수평면을 벗어나 현이 짧아진다.
  # 자세도 같이 돌아가므로 각 점에서 손이 그 자리의 법선을 본다.
  if (scan_radius &lt;= 0):
    return mid
  end
  fwd = pose_trans(mid, [0, 0, 1.0, 0, 0, 0])
  dx = fwd[0] - mid[0]
  dy = fwd[1] - mid[1]
  n = sqrt(dx * dx + dy * dy)
  if (n &lt; 0.0001):
    # 전진 방향이 거의 수직이다 = 벽을 보고 있지 않다. 그대로 둔다.
    return mid
  end
  r = scan_radius * 0.001
  o_t = [mid[0] + dx / n * r, mid[1] + dy / n * r, 0, 0, 0, 0]
  return pose_trans(o_t, pose_trans([0, 0, 0, 0, 0, th],
                   pose_trans(pose_inv(o_t), mid)))
end


def al_step(dmm):
  # TCP 기준 Z 로 dmm [mm] 만큼 움직인다. 음수가 전진(벽 쪽) — dmm 부호의
  # 의미는 예전(Y축) 그대로 두고, 축만 Y에서 Z로 바꾼다(그래서 부호가
  # 한 번 뒤집힌다: 예전 [0,dmm,0,0,0,0] -&gt; 이제 [0,0,-dmm,0,0,0]).
  movel(pose_trans(get_actual_tcp_pose(), [0, 0, -dmm * 0.001, 0, 0, 0]),
     a = a_l, v = v_l / 3.0)
end


def al_rush(t):
  movel(t, a = a_l, v = v_l / 3.0)
end


def al_press(target):
  # target 자세(계산값) 그대로, 그 지점의 로컬 +Z 로 전진해 실제 벽
  # 접촉을 찾는다 — probe_c 의 pc_press() 와 같은 방식이다.
  # 반환: 실제로 닿은 pose(자세는 target 유지, 위치만 실측으로 보정됨).
  # 못 찾으면 계산값으로 조용히 넘어가지 않는다 — 아래에서 멈춘다.
  global n_hit
  far = pose_trans(target, [0, 0, seek_limit * 0.001, 0, 0, 0])
  mv_h = start_thread(al_rush, (far,), detach_mode = False)
  while (True):
    if (get_standard_digital_in(di_touch) or get_standard_digital_in(di_limit)):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    if (pose_dist(get_actual_tcp_pose(), far) &lt; 0.0005):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    sync()
  end

  tries = 0
  while (get_standard_digital_in(di_limit) and tries &lt; seek_tries):
    tries = tries + 1
    al_step(seek_step)
    sync()
  end

  tries = 0
  while (get_standard_digital_in(di_touch) == False and tries &lt; seek_tries):
    tries = tries + 1
    al_step(-seek_step)
    sync()
  end

  if (get_standard_digital_in(di_touch)):
    n_hit = n_hit + 1
    return get_actual_tcp_pose()
  end
  # 계산값 대신 쓸 값이 없다 — 원점이 실측 없이 계산값으로 넘어가면
  # 스캔 전체가 잘못된 좌표로 돌게 되므로, 실패는 반드시 멈춰서 알려야 한다.
  popup(s = "PROBE_L: WALL CONTACT NOT FOUND", title = "dusan_v5", blocking = True)
  write_port_register(299, 2)
  write_port_register(290, 9)
  halt()
  return target
end


write_port_register(290, 3)

# 양 끝을 다 계산해 놓고, 베이스 Y 가 작은 쪽을 Y-(원점), 큰 쪽을 Y+ 로 나눈다.
# 손이 어느 방향을 보고 있느냐에 따라 +t 가 어느 쪽으로 갈지 달라지므로
# 부호를 미리 못 박지 않고 실제 좌표로 가른다.
# 호가 0 이면(반지름 0 또는 arc_run 0) al_arc 가 중앙점을 그대로 돌려줘
# 양 끝이 중앙과 겹친다. 그 상태로 진행하면 나중에 dus5_pass_r 의 servoj 호가
# "Target pose ... coincident with auxiliary pose" 로 죽는데, 그 문구만
# 보고는 원인을 알 수 없다. 여기서 값을 짚어 멈춘다.
if (scan_radius &lt;= 0 or arc_half == 0):
  popup(s = "ARC IS ZERO: check radius(260) and arc length(256)",
        title = "dusan_v5", blocking = True)
  write_port_register(299, 4)
  write_port_register(290, 9)
  halt()
end

end_a = al_arc(p_c_pose, arc_half)
end_b = al_arc(p_c_pose, -arc_half)
# 반시계 방향으로 훑는다. 원점은 베이스 Y 가 **큰** 쪽 끝이고, 거기서
# Y 가 줄어드는 방향으로 한 줄을 지난다. (예전에는 반대였다 — Y 가 작은
# 쪽이 원점이었다.) 발행하는 좌표는 dus5_init 의 pub_rel 이 Rz 180 도로
# 뒤집어 내보내므로, 이렇게 훑어도 Y 는 계속 + 로만 커진다.
if (end_a[1] &gt;= end_b[1]):
  zero_est = end_a
  p_r_pose = end_b
else:
  zero_est = end_b
  p_r_pose = end_a
end

# 계산한 원점(zero_est)의 대기 지점(TCP -Z 로 물러난 곳)까지 안전하게
# 이동한 뒤, 그 자세 그대로 전진해 실제 벽 접촉으로 원점을 보정한다.
#
# 여기 오기 전 위치(중앙, p_c_pose)에서 l_stand 까지는 호의 절반 가까이
# 자세가 크게 돌아간다. 한때 movej(get_inverse_kin(...))로 바꿨었는데,
# 좌우 이동은 movel(직선)로 가도록 되돌린다.
l_stand = pose_trans(zero_est, [0, 0, -probe_dist * 0.001, 0, 0, 0])
movel(l_stand, a = a_l, v = v_l)
zero_pose = al_press(zero_est)

# 이 자리가 원점이자 호의 시작점이다 (회전값 포함).
p_lx = zero_pose[0]
write_port_register(301, floor(p_lx * 10000 + 0.5))
al_w6(350, zero_pose)
zero_inv = pose_inv(zero_pose)
zero_ok = True

# ---- 호 위 위치를 실시간으로 내보내기 위한 기준 ---------------------------
# TPAC 은 스캔 축 위치로 **호 길이**를 받아야 한다. 좌표를 그대로 주면
# 현(1031.8)으로 7% 눌리고, 게다가 호 위치에 비례하지 않아 1/4·3/4 지점에서
# 14.6mm 씩 어긋난다(C-scan 이 앞뒤로 밀려 찍힌다).
# 곡률 중심과 원점의 방위각을 남겨 두면, 발행 스레드가 매 주기
#   s = R * |현재각 - 원점각|
# 으로 호 위 실제 거리를 계산할 수 있다.
if (scan_radius &gt; 0):
  fwd0 = pose_trans(p_c_pose, [0, 0, 1.0, 0, 0, 0])
  d0x = fwd0[0] - p_c_pose[0]
  d0y = fwd0[1] - p_c_pose[1]
  n0 = sqrt(d0x * d0x + d0y * d0y)
  if (n0 &gt; 0.0001):
    arc_ox = p_c_pose[0] + d0x / n0 * scan_radius * 0.001
    arc_oy = p_c_pose[1] + d0y / n0 * scan_radius * 0.001
    arc_phi0 = atan2(zero_pose[1] - arc_oy, zero_pose[0] - arc_ox)
    arc_ok = True
  end
end

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

# 벽에서 물러난다 (다음 동작에서 곡면을 가로지르지 않도록) — 좌우 이동은
# movel(직선)로 간다.
movel(l_stand, a = a_l, v = v_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_probe_l.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="7 move_start_waypoint" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_move_start_waypoint.script — dusan_v5
#  dus5_move_start.script 와 같되 **블렌드 반경(r_l)** 을 걸고 지나간다
#
#  펜던트의 Waypoint(경유점) 기능 대신 쓰는 스크립트다. 마지막 movel 에
#  r = r_l 을 주면 로봇이 start_pose 에 정확히 서지 않고 반경 r_l 안에서
#  둥글게 스치며 다음 동작으로 이어진다 — 프로브 사이를 오갈 때 매번
#  완전히 정지했다 다시 가속하는 것을 없애 사이클이 짧아진다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  블렌드를 걸면 **그 자리에 정확히 서지 않는다**. 그래서 다음 동작이
#  접촉 탐색(probe_c)처럼 시작점 정밀도를 요구하는 자리에는 쓰지 않고,
#  프로브 사이 이동처럼 지나가기만 하면 되는 자리에만 쓴다.
#  Z 올림(첫 movel)은 벽·바닥을 피하는 동작이라 블렌드를 걸지 않는다.
if (get_actual_tcp_pose()[2] &lt; start_pose[2] - 0.001):
  z_up = get_actual_tcp_pose()
  z_up[2] = start_pose[2]
  movel(z_up, a = a_l, v = v_l)
end
movel(start_pose, a = a_l, v = v_l, r = r_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_move_start_waypoint.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="8 [스크립트파일] dus5_probe_r.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_probe_r.script — dusan_v5
#  Y+ 끝점을 실제 벽 접촉으로 보정한다. 계산 목표는 dus5_probe_l 이 이미
#  해 두었다(p_r_pose, 아직 계산값).
#
#  펜던트에서 "5_probe_right" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  probe_l 과 같은 이유: 계산값만으로는 도면 반지름과 실제 벽의 오차가
#  그대로 남는다. probe_l이 계산해 둔 목표(p_r_pose)로 접근해 중앙과
#  똑같이 눌림 센서로 다시 찾는다(probe_c 의 pc_press() 와 같은 방식).
# =============================================================================

def pr_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


def pr_w6(a, p):
  pr_w1(a, p[0] * 10000)
  pr_w1(a + 1, p[1] * 10000)
  pr_w1(a + 2, p[2] * 10000)
  pr_w1(a + 3, p[3] * 1000)
  pr_w1(a + 4, p[4] * 1000)
  pr_w1(a + 5, p[5] * 1000)
end


def pr_step(dmm):
  # TCP 기준 Z 로 dmm [mm] 만큼 움직인다. 음수가 전진(벽 쪽) — dmm 부호의
  # 의미는 예전(Y축) 그대로 두고, 축만 Y에서 Z로 바꾼다(그래서 부호가
  # 한 번 뒤집힌다: 예전 [0,dmm,0,0,0,0] -&gt; 이제 [0,0,-dmm,0,0,0]).
  movel(pose_trans(get_actual_tcp_pose(), [0, 0, -dmm * 0.001, 0, 0, 0]),
     a = a_l, v = v_l / 3.0)
end


def pr_rush(t):
  movel(t, a = a_l, v = v_l / 3.0)
end


def pr_press(target):
  # target 자세(계산값) 그대로, 그 지점의 로컬 +Z 로 전진해 실제 벽
  # 접촉을 찾는다. 반환: 실제로 닿은 pose. 못 찾으면 계산값으로 조용히
  # 넘어가지 않는다 — 아래에서 멈춘다.
  global n_hit
  far = pose_trans(target, [0, 0, seek_limit * 0.001, 0, 0, 0])
  mv_h = start_thread(pr_rush, (far,), detach_mode = False)
  while (True):
    if (get_standard_digital_in(di_touch) or get_standard_digital_in(di_limit)):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    if (pose_dist(get_actual_tcp_pose(), far) &lt; 0.0005):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    sync()
  end

  tries = 0
  while (get_standard_digital_in(di_limit) and tries &lt; seek_tries):
    tries = tries + 1
    pr_step(seek_step)
    sync()
  end

  tries = 0
  while (get_standard_digital_in(di_touch) == False and tries &lt; seek_tries):
    tries = tries + 1
    pr_step(-seek_step)
    sync()
  end

  if (get_standard_digital_in(di_touch)):
    n_hit = n_hit + 1
    return get_actual_tcp_pose()
  end
  # 계산값 대신 쓸 값이 없다 — 실패는 반드시 멈춰서 알려야 한다.
  popup(s = "PROBE_R: WALL CONTACT NOT FOUND", title = "dusan_v5", blocking = True)
  write_port_register(299, 3)
  write_port_register(290, 9)
  halt()
  return target
end


# probe_l이 남겨 둔 계산 목표. 대기 지점(TCP -Z 로 물러난 곳)까지 안전하게
# 이동한 뒤, 그 자세 그대로 전진해 실제 벽 접촉으로 보정한다.
#
# 지금 로봇은 dus5_probe_l 이 끝낸 자리(Y- 끝)에 있고 r_stand 는 호 반대쪽
# (Y+ 끝) 이라, 호 전체 폭만큼 자세가 크게 돌아간다. 한때
# movej(get_inverse_kin(...))로 바꿨었는데, 좌우 이동은 movel(직선)로
# 가도록 되돌린다.
p_r_est = p_r_pose
r_stand = pose_trans(p_r_est, [0, 0, -probe_dist * 0.001, 0, 0, 0])
movel(r_stand, a = a_l, v = v_l)
p_r_pose = pr_press(p_r_est)

p_rx = p_r_pose[0]
write_port_register(302, floor(p_rx * 10000 + 0.5))
pr_w6(340, p_r_pose)

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

# 벽에서 물러난다 (다음 동작에서 곡면을 가로지르지 않도록) — 좌우 이동은
# movel(직선)로 간다.
movel(r_stand, a = a_l, v = v_l)

# 세 점이 그대로 호의 시작(원점) / 중앙 / 끝(Y+) 이 된다.
write_port_register(346, arc_mode)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_probe_r.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="9 move_start_waypoint" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_move_start_waypoint.script — dusan_v5
#  dus5_move_start.script 와 같되 **블렌드 반경(r_l)** 을 걸고 지나간다
#
#  펜던트의 Waypoint(경유점) 기능 대신 쓰는 스크립트다. 마지막 movel 에
#  r = r_l 을 주면 로봇이 start_pose 에 정확히 서지 않고 반경 r_l 안에서
#  둥글게 스치며 다음 동작으로 이어진다 — 프로브 사이를 오갈 때 매번
#  완전히 정지했다 다시 가속하는 것을 없애 사이클이 짧아진다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  블렌드를 걸면 **그 자리에 정확히 서지 않는다**. 그래서 다음 동작이
#  접촉 탐색(probe_c)처럼 시작점 정밀도를 요구하는 자리에는 쓰지 않고,
#  프로브 사이 이동처럼 지나가기만 하면 되는 자리에만 쓴다.
#  Z 올림(첫 movel)은 벽·바닥을 피하는 동작이라 블렌드를 걸지 않는다.
if (get_actual_tcp_pose()[2] &lt; start_pose[2] - 0.001):
  z_up = get_actual_tcp_pose()
  z_up[2] = start_pose[2]
  movel(z_up, a = a_l, v = v_l)
end
movel(start_pose, a = a_l, v = v_l, r = r_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_move_start_waypoint.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="10 [스크립트파일] dus5_mark_point.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_mark_point.script — dusan_v5 (마킹 태스크)
#  프로브 3점으로 잡은 호 위에서, 원점 기준 (u, v) 자리로 가서 벽에 붙는다
#
#  마킹 태스크(dusan_v5_mark.task)의 끝에서 두 번째 노드다. 앞에서
#  probe_c/l/r 가 이 구간의 호(p_c_pose, zero_pose, arc_half, scan_radius)를
#  새로 잡아 뒀으므로 그 기하를 그대로 쓴다.
#
#  입력 레지스터 (RCS 가 태스크를 틀기 전에 써 둔다):
#    268 = u  원점에서 호를 따라 간 거리 [mm]
#    269 = v  원점 높이에서 위로 [mm]
#  상태 290:
#    10 = 마킹 자리로 이동 중
#    11 = 마킹 자리에 붙음 (여기서 마킹 — 아직 TODO)
#  실패하면 299 = 5, 290 = 9 로 멈춘다.
#
#  바로 그 자리로 가지 않는다 — 프로브 때처럼 **TCP -Z 로 probe_dist 만큼
#  물러난 자세**로 먼저 가서, 거기서 TCP +Z 로 전진하다 센서가 적정 눌림이
#  되면 선다. 계산값만 믿고 들어가면 벽 두께·오차만큼 파고들거나 뜬다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 함수 이름은 mk_ 로 시작한다 — 태스크 전체가 한 스크립트로 이어
#    붙기 때문에 다른 파일의 함수와 이름이 겹치면 안 된다.
# =============================================================================

def mk_arc(mid, th):
  # dus5_probe_l.script 의 al_arc 와 같다: 중앙 접점 mid 에서 호를 따라
  # th [rad] 돌아간 점(자세 포함). 곡률 중심은 전진 방향의 수평 성분으로 R,
  # 회전은 그 중심을 지나는 수직축(베이스 Z)으로.
  if (scan_radius &lt;= 0):
    return mid
  end
  fwd = pose_trans(mid, [0, 0, 1.0, 0, 0, 0])
  dx = fwd[0] - mid[0]
  dy = fwd[1] - mid[1]
  n = sqrt(dx * dx + dy * dy)
  if (n &lt; 0.0001):
    return mid
  end
  r = scan_radius * 0.001
  o_t = [mid[0] + dx / n * r, mid[1] + dy / n * r, 0, 0, 0, 0]
  return pose_trans(o_t, pose_trans([0, 0, 0, 0, 0, th],
                   pose_trans(pose_inv(o_t), mid)))
end


def mk_step(dmm):
  # TCP 기준 Z 로 dmm [mm] 이동. 음수가 전진(벽 쪽) — probe 스크립트와 같은 규칙.
  movel(pose_trans(get_actual_tcp_pose(), [0, 0, -dmm * 0.001, 0, 0, 0]),
     a = a_l, v = v_l / 3.0)
end


def mk_rush(t):
  movel(t, a = a_l, v = v_l / 3.0)
end


def mk_press():
  # dus5_probe_c.script 의 pc_press 와 같다: 적정 눌림이 될 때까지 TCP +Z 전진.
  global n_hit
  x_home = get_actual_tcp_pose()
  far = pose_trans(x_home, [0, 0, seek_limit * 0.001, 0, 0, 0])
  mv_h = start_thread(mk_rush, (far,), detach_mode = False)
  while (True):
    if (get_standard_digital_in(di_touch) or get_standard_digital_in(di_limit)):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    if (pose_dist(get_actual_tcp_pose(), far) &lt; 0.0005):
      stop_thread(mv_h)
      stopl(1.2)
      break
    end
    sync()
  end
  tries = 0
  while (get_standard_digital_in(di_limit) and tries &lt; seek_tries):
    tries = tries + 1
    mk_step(seek_step)
    sync()
  end
  tries = 0
  while (get_standard_digital_in(di_touch) == False and tries &lt; seek_tries):
    tries = tries + 1
    mk_step(-seek_step)
    sync()
  end
  if (get_standard_digital_in(di_touch)):
    n_hit = n_hit + 1
    return True
  end
  popup(s = "MARK: WALL CONTACT NOT FOUND", title = "dusan_v5", blocking = True)
  write_port_register(299, 5)
  write_port_register(290, 9)
  halt()
  return False
end


# ------------------------------------------------------------------ 본문
write_port_register(290, 10)
mk_u = read_port_register(268, True)
mk_v = read_port_register(269, True)

# 원점(zero_pose)이 호의 어느 끝인지 부호로 가린다. probe_l 은 베이스 Y 로
# 끝을 골랐으므로(반시계), 여기서는 두 끝 중 zero_pose 에 가까운 쪽을 본다.
mk_a = mk_arc(p_c_pose, arc_half)
mk_b = mk_arc(p_c_pose, -arc_half)
mk_s = 1
if (pose_dist(mk_b, zero_pose) &lt; pose_dist(mk_a, zero_pose)):
  mk_s = -1
end
# u = 0 이면 원점(th = s*arc_half), u = arc_run 이면 반대쪽 끝(-s*arc_half).
mk_th = mk_s * (arc_half - mk_u * 1.0 / scan_radius)
mk_tgt = mk_arc(p_c_pose, mk_th)
mk_tgt[2] = zero_pose[2] + mk_v * 0.001

# 물러난 자세로 먼저 간다(곡면을 가로지르지 않게 probe 들과 같은 방식).
mk_stand = pose_trans(mk_tgt, [0, 0, -probe_dist * 0.001, 0, 0, 0])
movel(mk_stand, a = a_l, v = v_l)
mk_press()
write_port_register(290, 11)

# TODO: 마킹. 스프레이/마커가 ERUT 쪽인지 로봇 쪽인지 정해지면 여기서
#       켜고 끈다(로봇 쪽이면 set_standard_digital_out 으로).

# 벽에서 물러난다 — 다음 노드(dus5_home)가 올라가며 곡면을 긁지 않게.
movel(pose_trans(get_actual_tcp_pose(), [0, 0, -probe_dist * 0.001, 0, 0, 0]),
      a = a_l, v = v_l)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_mark_point.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="11 [스크립트파일] dus5_home.script" isHideSubtree="false" typeName="Folder">
      <ScriptNode scriptType="FILE_TYPE" typeName="Script">
        <cachedFileContents># =============================================================================
#  dus5_home.script — dusan_v5
#  홈 높이만큼 먼저 올라간 뒤 moveJ 로 홈 자세로 간다
#
#  마킹 태스크의 마지막 노드. 펜던트의 move_home 노드와 같은 순서지만
#  스크립트로 두어 끝나고 상태를 알린다:
#    290 = 13  홈으로 가는 중
#    290 = 12  홈 도착 = 마킹 작업 끝 (RCS 가 이걸 보고 다음 점으로 간다)
#
#  ※ def main() 으로 감싸지 말 것
# =============================================================================
write_port_register(290, 13)
# 벽에 붙어 있을 수 있으니 먼저 TCP -Z 로 물러난다. 단 홈 자세보다 더
# 뒤로는 안 간다 — 홈이 TCP 축으로 뒤에 있는 만큼만, 최대 probe_dist.
# (RCS 의 홈 이동 명령과 같은 규칙이다.)
hm_cur = get_actual_tcp_pose()
hm_rel = pose_trans(pose_inv(hm_cur), Home_pose)
hm_back = -hm_rel[2]
if (hm_back &gt; probe_dist * 0.001):
  hm_back = probe_dist * 0.001
end
if (hm_back &gt; 0.001):
  movel(pose_trans(hm_cur, [0, 0, -hm_back, 0, 0, 0]), a = a_l, v = v_l)
end
if (get_actual_tcp_pose()[2] &lt; Home_pose[2] - 0.001):
  hm_up = get_actual_tcp_pose()
  hm_up[2] = Home_pose[2]
  movel(hm_up, a = a_l, v = v_l)
end
movej(Home_joint, a = a_j, v = v_j)
write_port_register(290, 12)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v5/scripts/dus5_home.script"/>
      </ScriptNode>
