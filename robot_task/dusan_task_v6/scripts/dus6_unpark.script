# =============================================================================
#  dus6_unpark.script — dusan_v6
#  받침대 위의 로봇 팔을 들어 홈으로 되돌린다 (받침대 -> 홈 = 로봇팔 ready)
#
#  dusan_v6_unpark.task 의 하나뿐인 노드다(파일 모드 스크립트 노드). 차량이 고정된 뒤,
#  로봇이 움직이거나 리프트가 0 mm 에서 올라가기 전에 펜던트에서 이 태스크를 불러와 돌린다.
#  dus6_park.script 를 거꾸로 간다:
#
#    ④ 받침대 위 (Park_rest_joint)
#       --movel--> ③ 뻗은 자세 (Park_reach_joint, 받침대에서 위로 — park_v_touch 로 천천히)
#       --movel--> ② 든 자세   (Park_lift_joint,  베이스 -Y 로 물러남)
#       --movel--> ① 회전 자세 (Park_turn_joint,  TCP 를 아래로)
#       --movej--> 홈           (Home_joint — 홈에 닿으면 276 = 1, 360 = 4 = 로봇팔 ready)
#
#  중간에 멈췄으면(어느 자세에 서 있으면) 그 다음 자세부터 이어 간다. 이미 홈이면 움직이지 않고
#  ready 만 알린다. 저장한 자세 어디에도 있지 않으면 움직이지 않는다.
#
#  차량 고정 확인(309): RCS 가 작업 값을 넣어 둔 때(266 = 1)만 dus6_init 처럼 309 = 1(차량 정지 ·
#  아웃트리거 고정 · 리프트 정지)을 기다린다. 펜던트만으로 돌릴 때(266 != 1)는 기다리지 않는다.
#
#  레지스터 360 · 276 은 dus6_park.script 머리말 참고.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def uk_set(q):
  # 저장한 적이 있는 자세인가 — 6 축이 전부 0 이면 비어 있다.
  uk_k = 0
  while (uk_k < 6):
    if (q[uk_k] != 0):
      return True
    end
    uk_k = uk_k + 1
  end
  return False
end


def uk_far(q, ref):
  # 두 관절값의 가장 큰 차이 [rad]
  uk_i = 0
  uk_m = 0
  while (uk_i < 6):
    uk_d = q[uk_i] - ref[uk_i]
    if (uk_d < 0):
      uk_d = -uk_d
    end
    if (uk_d > uk_m):
      uk_m = uk_d
    end
    uk_i = uk_i + 1
  end
  return uk_m
end


def uk_near(ref):
  # 지금 이 자세에 서 있는가 — 관절이 home_tol_j 안이거나, 관절이 달라도 플랜지 자리가
  # home_tol_p [mm] 안이면(같은 자리를 다른 해로 잡은 경우) 서 있는 것으로 본다.
  if (uk_far(get_actual_joint_positions(), ref) <= home_tol_j):
    return True
  end
  uk_r = get_forward_kin(ref)
  uk_c = get_actual_tool_flange_pose()
  uk_j = 0
  while (uk_j < 3):
    uk_e = uk_c[uk_j] - uk_r[uk_j]
    if (uk_e < 0):
      uk_e = -uk_e
    end
    if (uk_e > home_tol_p * 0.001):
      return False
    end
    uk_j = uk_j + 1
  end
  return True
end


def uk_stage():
  # 지금 서 있는 자세: 0 홈 · 1 회전 자세 · 2 든 자세 · 3 뻗은 자세 · 4 받침대 위 · -1 어디도 아님.
  # 홈 쪽부터 본다 — 이미 홈이면 아무것도 하지 않는다.
  if (uk_near(Home_joint)):
    return 0
  end
  if (uk_near(Park_turn_joint)):
    return 1
  end
  if (uk_near(Park_lift_joint)):
    return 2
  end
  if (uk_near(Park_reach_joint)):
    return 3
  end
  if (uk_near(Park_rest_joint)):
    return 4
  end
  return -1
end


def uk_stop(msg, untaught):
  # 위치가 비어 있어 못 하면 360 = 9. 자세 사이 · 차량 미고정이면 360 을 그대로 둔다 — 팔이 받침대
  # 길에 있을 수 있어, RCS 「로봇 홈」이 계속 되돌리기(이 거절)로 와야 한다(스캔 대기 위치 길로 가면 안 된다).
  if (untaught):
    write_port_register(360, 9)
  end
  popup(s = msg, title = "dusan_v6 unpark", blocking = True)
  halt()
end


def uk_veh_wait():
  # 차량 고정(309 = 1)을 기다린다 — dus6_init 의 ini_veh_wait 와 같다(290 은 건드리지 않는다).
  if (read_port_register(266, True) != 1):
    return True
  end
  uk_vt = 0
  while (read_port_register(309, True) != 1):
    sync()
    uk_vt = uk_vt + 1
    if (uk_vt > veh_wait_cyc):
      write_port_register(299, 8)
      uk_stop("UNPARK: VEHICLE NOT FIXED (309)", False)
    end
  end
  return True
end


# ---- 플랜지 기준 -----------------------------------------------------------
set_tcp([0, 0, 0, 0, 0, 0])

# ---- 홈 = RCS 「홈 위치 저장」(328 = 1, 322~327 [mRad]) 또는 펜던트 Home_joint ----
if (read_port_register(328, True) == 1):
  uk_h = [read_port_register(322, True) / 1000.0, read_port_register(323, True) / 1000.0,
          read_port_register(324, True) / 1000.0, read_port_register(325, True) / 1000.0,
          read_port_register(326, True) / 1000.0, read_port_register(327, True) / 1000.0]
  if (uk_set(uk_h)):
    Home_joint = uk_h
  end
end

# ---- 저장한 네 자세가 다 있어야 움직인다 ------------------------------------
if (uk_set(Park_turn_joint) == False or uk_set(Park_lift_joint) == False or uk_set(Park_reach_joint) == False or uk_set(Park_rest_joint) == False):
  uk_stop("UNPARK: TEACH Park_turn/lift/reach/rest_joint FIRST", True)
end

# ---- 속도 : 기준값에서 매번 새로 정한다(dus6_init 과 같은 상한) -----------------
uk_vj = v_move_j_set
if (uk_vj > 0.50 or uk_vj <= 0):
  uk_vj = 0.34907
end
uk_aj = a_move_j_set
if (uk_aj > 1.40 or uk_aj <= 0):
  uk_aj = 0.69813
end
uk_vl = park_v_l
if (uk_vl > 0.250 or uk_vl <= 0):
  uk_vl = 0.1
end
uk_vt = park_v_touch
if (uk_vt > uk_vl or uk_vt <= 0):
  uk_vt = 0.02
end
uk_al = a_move_set
if (uk_al > 0.400 or uk_al <= 0):
  uk_al = 0.2
end

# ---- 받침대 -> 홈 -----------------------------------------------------------
uk_s = uk_stage()
if (uk_s < 0):
  uk_stop("UNPARK: NOT ON THE REST OR A PARK POSE - JOG TO THE NEAREST ONE", False)
end
if (uk_s > 0):
  uk_veh_wait()
  write_port_register(360, 3)
  write_port_register(276, 0)
end
if (uk_s == 4):
  movel(get_forward_kin(Park_reach_joint), a = uk_al, v = uk_vt)
end
if (uk_s >= 3):
  movel(get_forward_kin(Park_lift_joint), a = uk_al, v = uk_vl)
end
if (uk_s >= 2):
  movel(get_forward_kin(Park_turn_joint), a = uk_al, v = uk_vl)
end
if (uk_s >= 1):
  movej(Home_joint, a = uk_aj, v = uk_vj)
end
write_port_register(276, 1)
write_port_register(360, 4)
