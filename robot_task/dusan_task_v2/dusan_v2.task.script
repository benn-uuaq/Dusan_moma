    # 쓰인다. X,Y 만 맞추고 앞 측정에서 돌아간 자세를 남겨 두면 스캔 내내
    # 엉뚱한 각도로 훑게 된다 — 측정한 3점의 의미가 사라진다.
    movel(zero_pose, a = 1.2, v = v_move)

