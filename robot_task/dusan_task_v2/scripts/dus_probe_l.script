# =============================================================================
#  dus_probe_l.script — dusan_v2
#  캘리브레이션한 중앙점에서 호의 양 끝점을 **계산**한다. 이 중 Y+ 끝이 원점.
#
#  펜던트에서 "4_probe_left" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
#
#  센서가 중앙 하나뿐이라 양 끝은 짚지 않는다. 중앙에서 잰 '적정 눌림' 깊이가
#  호 전체에 그대로 적용된다고 보고, 끝점은 반지름·호각으로 계산한다.
#
#  기하: 중앙 접점 P 에서 TCP -Y 로 R 만큼 간 곳이 곡률 중심 O 다
#  (바깥 볼록면을 훑으므로 중심은 벽 뒤에 있다). O 를 로컬 Z 로 t 만큼 돌린 뒤
#  다시 로컬 +Y 로 R 만큼 나오면 호 위의 점이 되고, **손 방향도 그 점의
#  법선으로 같이 돌아간다** — movec 에 그대로 쓸 수 있는 자세다.
# =============================================================================

def al_w1(a, v):
  if (v > 32000):
    v = 32000
  end
  if (v < -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


def al_w6(a, p):
  al_w1(a, p[0] * 10000)
  al_w1(a + 1, p[1] * 10000)
  al_w1(a + 2, p[2] * 10000)
  al_w1(a + 3, p[3] * 1000)
  al_w1(a + 4, p[4] * 1000)
  al_w1(a + 5, p[5] * 1000)
end


def al_arc(mid, th):
  # 중앙 접점 mid 에서 호를 따라 th [rad] 만큼 돌아간 점(자세 포함).
  #
  # 원통은 세워져 있으므로 호는 **수평면** 안에 있다. 그래서
  #   (1) 곡률 중심 O 는 접점에서 '전진 방향(TCP -Y)의 **수평 성분**'으로 R.
  #       TCP -Y 가 조금 기울어 있어도 수평 성분만 써야 반지름이 맞는다.
  #   (2) 회전은 O 를 지나는 **수직축(베이스 Z)** 으로 한다.
  #       툴 로컬 Z 로 돌리면 호가 수평면을 벗어나 현이 짧아진다.
  # 자세도 같이 돌아가므로 각 점에서 손이 그 자리의 법선을 본다.
  if (app_radius <= 0):
    return mid
  end
  fwd = pose_trans(mid, [0, -1.0, 0, 0, 0, 0])
  dx = fwd[0] - mid[0]
  dy = fwd[1] - mid[1]
  n = sqrt(dx * dx + dy * dy)
  if (n < 0.0001):
    # 전진 방향이 거의 수직이다 = 벽을 보고 있지 않다. 그대로 둔다.
    return mid
  end
  r = app_radius * 0.001
  o_t = [mid[0] + dx / n * r, mid[1] + dy / n * r, 0, 0, 0, 0]
  return pose_trans(o_t, pose_trans([0, 0, 0, 0, 0, th],
                   pose_trans(pose_inv(o_t), mid)))
end


write_port_register(290, 3)

# 양 끝을 다 계산해 놓고, 베이스 Y 가 큰 쪽을 Y+(원점), 작은 쪽을 Y- 로 나눈다.
# 손이 어느 방향을 보고 있느냐에 따라 +t 가 어느 쪽으로 갈지 달라지므로
# 부호를 미리 못 박지 않고 실제 좌표로 가른다.
end_a = al_arc(p_c_pose, arc_half)
end_b = al_arc(p_c_pose, -arc_half)
if (end_a[1] >= end_b[1]):
  zero_pose = end_a
  p_r_pose = end_b
else:
  zero_pose = end_b
  p_r_pose = end_a
end

# 이 자리가 원점이자 movec 의 시작점이다 (회전값 포함).
p_lx = zero_pose[0]
write_port_register(301, floor(p_lx * 10000 + 0.5))
al_w6(350, zero_pose)
zero_inv = pose_inv(zero_pose)
zero_ok = True

# ---- 호 위 위치를 실시간으로 내보내기 위한 기준 ---------------------------
# TPAC 은 스캔 축 위치로 **호 길이**를 받아야 한다. 좌표를 그대로 주면
# 현(1031.8)으로 7% 눌리고, 게다가 호 위치에 비례하지 않아 1/4·3/4 지점에서
# 14.6mm 씩 어긋난다(C-scan 이 앞뒤로 밀려 찍힌다).
# 곡률 중심과 원점의 방위각을 남겨 두면, 발행 스레드가 매 주기
#   s = R * |현재각 - 원점각|
# 으로 호 위 실제 거리를 계산할 수 있다.
if (app_radius > 0):
  fwd0 = pose_trans(p_c_pose, [0, -1.0, 0, 0, 0, 0])
  d0x = fwd0[0] - p_c_pose[0]
  d0y = fwd0[1] - p_c_pose[1]
  n0 = sqrt(d0x * d0x + d0y * d0y)
  if (n0 > 0.0001):
    arc_ox = p_c_pose[0] + d0x / n0 * app_radius * 0.001
    arc_oy = p_c_pose[1] + d0y / n0 * app_radius * 0.001
    arc_phi0 = atan2(zero_pose[1] - arc_oy, zero_pose[0] - arc_ox)
    arc_ok = True
  end
end

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)
