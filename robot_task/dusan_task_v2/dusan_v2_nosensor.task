          </Expression>
          <children>
            <FolderNode display="8 [스크립트파일] dus_pass_l.script" isHideSubtree="false" typeName="폴더">
              <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
                <cachedFileContents># =============================================================================
#  dus_pass_l.script — dusan_v2
#  왼쪽(Y+) 으로 한 줄. 중앙을 경유점으로 하는 movec 원호
#
#  펜던트에서 &quot;8_pass_left&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def pl2_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


# 왼쪽(Y+) 으로 한 줄 — movec 원호 하나
z_now = get_actual_tcp_pose()[2]
via_pose = p_c_pose.copy()
via_pose[2] = z_now
to_pose = zero_pose.copy()
to_pose[2] = z_now
movec(via_pose, to_pose, a = 0.6, v = v_scan, r = 0, mode = 1)

row_idx = row_idx + 1
dir_sign = 1
pass_done = 1
# movec 는 호를 따라가므로 실제 지난 거리는 현이 아니라 호 길이다.
# 총 작업 거리는 TCP 가 실제로 움직인 길이다. EOAT 폭만큼 짧으므로
# 덮는 길이(app_arc)가 아니라 arc_run 을 더한다.
path_len = path_len + arc_run
write_port_register(291, row_idx)
pl2_w1(297, path_len * 0.1)
pl2_w1(298, row_idx * 100.0 / rows)
</cachedFileContents>
