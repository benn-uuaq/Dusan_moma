<EliTask name="dusan_v2_nosensor" installationName="dusan_v2" robotType="CS612" toolType="0" createdVersion="2.15.0.477" lastSavedVersion="2.16.0.964" robotSN="11111111111111" savedTime="2026-08-28 15:49:45" directory="Dusan/dusan_v2" installationDirectory="/Dusan/dusan_v2" typeName="로봇 메인 작업">
  <InitVariables typeName="변수 값 초기화"/>
  <MainTask isTaskAlwaysLoops="true" hasBeforeStart="false" hasInitVariables="true" typeName="로봇 메인 작업">
    <FolderNode display="1 [스크립트파일] dus_init.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_init.script — dusan_v2
#  파라미터를 읽고 피치·행수를 계산한다. 실시간 발행 스레드를 띄운다
#
#  펜던트에서 &quot;1_init&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def ini_w1(a, v):
  if (v &gt; 32000):
    v = 32000
  end
  if (v &lt; -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


# 로봇 자체 레지스터 384~389 와 같은 단위.  길이 0.1mm, 회전 mRad
def ini_w6(a, p):
  ini_w1(a, p[0] * 10000)
  ini_w1(a + 1, p[1] * 10000)
  ini_w1(a + 2, p[2] * 10000)
  ini_w1(a + 3, p[3] * 1000)
  ini_w1(a + 4, p[4] * 1000)
  ini_w1(a + 5, p[5] * 1000)
end


# 절대 TCP(260~265) 는 항상 발행한다. 원점기준 상대좌표(280~285)와 호
# 위치(286/287)는 원점(zero_pose)이 잡혀 있으면(zero_ok/arc_ok) 항상
# 내보낸다 — TPAC 의 &quot;Plane&quot; 이 실제 TCP 이동거리를 보여줘야 하므로 ㄹ자
# 스캔 중(state=4)만이 아니라 3점측정 후 원점복귀·다음 줄 이동 중에도
# 값이 살아 있어야 한다. 원점이 아직 없으면(zero_ok==False) [0,0,0,0,0,0]
# 을 쏜다.
#
# 위치는 베이스 좌표계 그대로 빼서 쓴다(cur - zero). 원래는
# pose_trans(zero_inv, cur_pose)로 툴 좌표계 기준값을 냈는데, 툴이
# 벽을 비스듬히 보고 있으면 베이스 Z+ 로 올라가도 이 값의 Z 성분이
# 음수로 커지는 문제가 있었다. register_map.txt 4항의 역변환 공식
# base = R_zero * rel_tcp 은 rel_tcp = R_zero^T * (cur-zero) 이므로
# 결국 cur - zero 와 정확히 같다(회전행렬을 걸었다 다시 푸는 셈).
# 그러니 처음부터 베이스 좌표계로 빼면 회전행렬 없이 같은 결과이고,
# 세로(Z)가 위로 갈수록 커지도록 직관과도 맞는다.
def pub_rel():
  global cur_pose
  global rel_pose
  global alive
  cur_pose = get_actual_tcp_pose()
  ini_w6(260, cur_pose)
  if (zero_ok == True):
    rel_pose = [cur_pose[0] - zero_pose[0],
          cur_pose[1] - zero_pose[1],
          cur_pose[2] - zero_pose[2],
          cur_pose[3] - zero_pose[3],
          cur_pose[4] - zero_pose[4],
          cur_pose[5] - zero_pose[5]]
    ini_w6(280, rel_pose)
  else:
    ini_w6(280, [0, 0, 0, 0, 0, 0])
  end
  # ---- 호 위 위치 (TPAC 스캔 축) ----------------------------------
  # 좌표를 그대로 주면 현(1031.8)으로 7% 눌리고 호 위치에 비례하지도
  # 않는다. 원점부터 호를 따라 실제로 지난 거리를 계산해서 내보낸다.
  #   286 = 이번 줄의 호 위 거리 [0.1mm]  (0 ~ 11100)
  #   287 = 완료된 줄까지 더한 누적 [mm]
  if (arc_ok == True):
    adx = cur_pose[0] - arc_ox
    ady = cur_pose[1] - arc_oy
    aph = atan2(ady, adx) - arc_phi0
    # atan2 는 ±pi 로 감기므로 한 바퀴 보정한다
    if (aph &gt; 3.14159265):
      aph = aph - 6.28318531
    end
    if (aph &lt; -3.14159265):
      aph = aph + 6.28318531
    end
    if (aph &lt; 0):
      aph = -aph
    end
    arc_s = aph * app_radius
    ini_w1(286, arc_s * 10)
    ini_w1(287, path_len + arc_s)
  else:
    arc_s = 0
    ini_w1(286, 0)
    ini_w1(287, path_len)
  end

  alive = alive + 1
  if (alive &gt; 30000):
    alive = 0
  end
  write_port_register(293, alive)
end


# 제어주기마다 도는 발행 스레드. 이 뒤로는 평범한 movel 을 써도
# 이동 중 좌표가 계속 나간다.
def pub_thread():
  while (True):
    pub_rel()
    sync()
  end
end


# ------------------------------------------------------------------ 본문
# 266 = 1 이면 외부(Modbus)가 준 값을, 0 이면 펜던트 변수값을 쓴다
#   256 호 길이 [mm]   257 격자 높이 [mm]   258 스캐너 높이 [mm]
#   259 겹침 [mm]      260 반지름 [0.1mm]   261 두께 [0.1mm]
# 260/261 만 0.1mm 인 이유: 반지름이 834.6 처럼 소수라 정수 mm 로는
# 호 모양이 눈에 띄게 틀어진다.
if (read_port_register(266, True) == 1):
  app_arc = read_port_register(256, True)
  app_height = read_port_register(257, True)
  scan_h = read_port_register(258, True)
  overlap = read_port_register(259, True)
  app_radius = read_port_register(260, True) * 0.1
  app_thick = read_port_register(261, True) * 0.1
  eoat_w = read_port_register(262, True)
  eoat_h = read_port_register(263, True)
end

# ---- EOAT(검사 프로브 뭉치) 크기 ------------------------------------------
# 프로브가 EOAT 폭만큼 퍼져 있으므로 TCP 가 격자 끝까지 갈 필요가 없다.
# 양 끝에서 EOAT 의 **반**씩 안쪽으로 들어가면 프로브 가장자리가 끝에 닿는다.
# 그래서 실제 이동 호 길이는 덮는 길이에서 EOAT 폭 하나를 뺀 값이다.
#   5축 X형 257x257 -&gt; 1110-257 = 853,  8축 186x316 -&gt; 1110-186 = 924
# 세로도 마찬가지로 EOAT 세로가 곧 한 줄이 덮는 밴드 높이(scan_h)가 된다.
if (eoat_h &gt; 0):
  scan_h = eoat_h
end
if (eoat_w &gt; 0):
  arc_run = app_arc - eoat_w
  if (arc_run &lt; 1):
    # EOAT 가 격자보다 넓다 = 한 자리에서 다 덮는다. 움직이지 않는다.
    arc_run = 0
  end
else:
  arc_run = app_arc
end

if (app_arc &lt;= 0):
  app_arc = 1000
end
if (app_radius &lt; 0):
  app_radius = 0
end

# ---- 훑는 면의 반지름 -----------------------------------------------------
# 도면 반지름은 안쪽(오목) 면 기준이고 로봇은 바깥(볼록) 면을 훑으므로
# 두께를 더해야 실제로 손이 닿는 면의 반지름이 된다 (834.6 + 10 = 844.6).
if (app_radius &gt; 0):
  app_radius = app_radius + app_thick
end

# ---- 호 기하 --------------------------------------------------------------
# 받은 값은 **호 길이**다(현이 아니다). 반각 t = L/(2R), 현 c = 2R*sin(t).
#   시험 벽: L=1110, R=844.6 -&gt; t=0.6571 rad(37.6deg), c=1031.8
# 로봇이 실제로 지나는 길이는 movec 가 호를 따라가므로 호 길이(1110) 다.
if (app_radius &gt; 0):
  arc_half = arc_run / (2.0 * app_radius)
  app_width = 2.0 * app_radius * sin(arc_half)
else:
  arc_half = 0
  app_width = arc_run
end

if (app_height &lt; 0):
  app_height = 0
end
if (scan_h &lt;= 0):
  scan_h = 200
end
if (overlap &lt; 0):
  overlap = 0
end
if (overlap &gt;= scan_h):
  overlap = scan_h - 10
end

# ---- 속도 : 외부(UI)가 306/307 에 쓴 값을 받는다 -----------------------
# 306 = 작업 속도 [mm/s]. movel 의 v 로 쓴다. 0 이면 변수값을 유지한다.
# 307 = 로봇 자체 속도 비율 [%] 2~100. 모든 이송 속도에 곱한다.
spd_in = read_port_register(306, True)
if (spd_in &gt; 0):
  v_move = spd_in / 1000.0
end

# ---- 안전 상한 : TCP 속도는 어떤 경우에도 150 mm/s 를 넘지 않는다 -------
# 안전 기준값이다. 외부(UI/MQTT)가 더 큰 값을 보내와도 여기서 막는다.
# 비율(307)을 곱하기 전에 자르므로 100 % 가 곧 150 mm/s 다.
v_limit = 0.150
if (v_move &gt; v_limit):
  v_move = v_limit
end
if (v_scan &gt; v_limit):
  v_scan = v_limit
end
if (v_seek &gt; v_limit):
  v_seek = v_limit
end

spd_ratio = read_port_register(307, True)
if (spd_ratio &lt; 2):
  spd_ratio = 100
end
if (spd_ratio &gt; 100):
  spd_ratio = 100
end
v_move = v_move * spd_ratio / 100.0
v_scan = v_scan * spd_ratio / 100.0
v_seek = v_seek * spd_ratio / 100.0

# ---- 기준 위치 : 308 이 1 이면 310~321 의 값을 쓴다 --------------------
# 310~315 홈 관절값 [mRad], 316~321 시작 pose (길이 0.1mm, 회전 mRad)
if (read_port_register(308, True) == 1):
  Home_joint = [read_port_register(310, True) / 1000.0,
         read_port_register(311, True) / 1000.0,
         read_port_register(312, True) / 1000.0,
         read_port_register(313, True) / 1000.0,
         read_port_register(314, True) / 1000.0,
         read_port_register(315, True) / 1000.0]
  start_pose = [read_port_register(316, True) / 10000.0,
         read_port_register(317, True) / 10000.0,
         read_port_register(318, True) / 10000.0,
         read_port_register(319, True) / 1000.0,
         read_port_register(320, True) / 1000.0,
         read_port_register(321, True) / 1000.0]
  Home_pose = get_forward_kin(Home_joint)
end

# 상승 피치 = 스캐너 높이 - 겹침 (고정)
pitch = scan_h - overlap
if (pitch &lt;= 0):
  pitch = 10
end

# 스캐너가 한 자리에서 scan_h 를 훑으므로
# 마지막 패스가 (높이 - scan_h) 이상이면 사각형 전체가 덮인다
rows = ceil((app_height - scan_h) * 1.0 / pitch) + 1
if (rows &lt; 1):
  rows = 1
end
if (rows &gt; 200):
  popup(s = &quot;ROWS OVER LIMIT(200). CHECK HEIGHT/SCAN_H/OVERLAP&quot;, title = &quot;dusan_v2&quot;, blocking = True)
  write_port_register(290, 9)
  halt()
end

row_idx = 0
dir_sign = 1
pass_done = 0
path_len = 0
alive = 0
zero_ok = False
n_probe = 0
n_hit = 0
qa = 0
qb = 0
qc = 0

write_port_register(290, 0)
write_port_register(291, 0)
write_port_register(292, rows)
write_port_register(293, 0)
write_port_register(294, 0)
write_port_register(295, 0)
write_port_register(296, pitch)
write_port_register(297, 0)
write_port_register(298, 0)
write_port_register(304, 0)
write_port_register(305, 0)

# 실시간 발행 스레드 기동
pub_h = start_thread(pub_thread, (), detach_mode = True)</cachedFileContents>
