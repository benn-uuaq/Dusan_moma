# =============================================================================
#  dus_probe_c.script — dusan_v1
#  중앙에서 전진해 벽을 찾고 X 를 기록한 뒤 후퇴한다
#
#  펜던트에서 "3_probe_center" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

write_port_register(290, 2)
    y_c = get_actual_tcp_pose()[1]
    z_base = get_actual_tcp_pose()[2]
    
# 중앙점 접근
def pc_move():
  movel(tgt_pose, a = 1.2, v = v_seek)
end

x_start = get_actual_tcp_pose()[0]
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start + seek_limit * 0.001
mv_h = start_thread(pc_move, (), detach_mode = False)
while (True):
  if (get_standard_digital_in(sensor_di1) and get_standard_digital_in(sensor_di2)):
    stop_thread(mv_h)
    stopl(1.2)
    break
  end
  if (get_actual_tcp_pose()[0] >= tgt_pose[0] - 0.0005):
    stop_thread(mv_h)
    stopl(1.2)
    break
  end
  sync()
end

# 센서로 멈췄는지 한계로 멈췄는지 기록 (센서가 아직 없어도 계속 진행한다)
if (get_standard_digital_in(sensor_di1) and get_standard_digital_in(sensor_di2)):
  n_hit = n_hit + 1
end
n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

    p_cx = get_actual_tcp_pose()[0]
    write_port_register(300, floor(p_cx * 10000 + 0.5))
    
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start
movel(tgt_pose, a = 1.2, v = v_move)
