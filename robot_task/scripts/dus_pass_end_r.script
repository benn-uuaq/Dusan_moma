# =============================================================================
#  dus_pass_end_r.script — dusan_v1 태스크용
#  가로 패스 한 줄을 마쳤을 때. 다음 차례는 왼쪽
#
#  펜던트에서 "7_pass_end_r" 위치에 스크립트 노드를 파일(File) 모드로 넣고
#  이 파일을 지정한다.
#
#  ※ 파일끼리 함수를 공유할 수 없어서 필요한 헬퍼를 이 파일 안에 직접 둔다.
#     이름이 겹치지 않게 접두사(per)를 붙였다.
#
#  ※ def main() 으로 감싸지 말 것. 펜던트는 파일 내용을 그 자리에 그대로
#     끼워 넣기만 하고 main() 을 호출하지 않는다. 감싸면 아무것도 실행되지 않는다.
#  ※ 최상위에 global 을 쓰지 말 것. 설정 변수는 펜던트 preamble 이 이미
#     global 선언 + 대입을 해 둬서, 같은 스코프에서 다시 선언하면
#     "assigned to before global declaration" 오류가 난다. 대입만 하면 된다.
# =============================================================================


def per_w1(a, v):
  if (v > 32000):
    v = 32000
  end
  if (v < -32000):
    v = -32000
  end
  write_port_register(a, floor(v + 0.5))
end


# 로봇 자체 레지스터 384~389 와 같은 단위를 쓴다.
#   길이 -> 0.1mm (m * 10000),  회전 -> mRad (rad * 1000)
def per_w6(a, p):
  per_w1(a, p[0] * 10000)
  per_w1(a + 1, p[1] * 10000)
  per_w1(a + 2, p[2] * 10000)
  per_w1(a + 3, p[3] * 1000)
  per_w1(a + 4, p[4] * 1000)
  per_w1(a + 5, p[5] * 1000)
end


row_idx = row_idx + 1
dir_sign = -1
pass_done = 1
path_len = path_len + app_width

write_port_register(291, row_idx)
per_w1(297, path_len * 0.1)
per_w1(298, row_idx * 100.0 / rows)
