    <FolderNode display="3 [스크립트파일] dus_probe_c.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_probe_c.script — dusan_v1
#  중앙에서 전진해 벽을 찾고 X 를 기록한 뒤 후퇴한다
#
#  펜던트에서 &quot;3_probe_center&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

write_port_register(290, 2)
    y_c = get_actual_tcp_pose()[1]
    z_base = get_actual_tcp_pose()[2]
    
# 중앙점 접근  [임시판 : 센서 없이 정해진 거리만 전진]
x_start = get_actual_tcp_pose()[0]
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start + (probe_dist + probe_bow) * 0.001
movel(tgt_pose, a = 1.2, v = v_seek)

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

    p_cx = get_actual_tcp_pose()[0]
    write_port_register(300, floor(p_cx * 10000 + 0.5))
    
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start
movel(tgt_pose, a = 1.2, v = v_move)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v1/scripts_nosensor/dus_probe_c.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="4 [스크립트파일] dus_probe_l.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_probe_l.script — dusan_v1
#  Y+ 로 너비/2 이동해 측정한다. 이 점이 원점이 된다
#
#  펜던트에서 &quot;4_probe_left&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

# 중앙에서 Y+ 로 너비의 절반만큼
    tgt_pose = get_actual_tcp_pose()
    tgt_pose[1] = y_c + app_width * 0.0005
    movel(tgt_pose, a = 1.2, v = v_move)
    y_l = get_actual_tcp_pose()[1]
    
# Y+ 끝 접근  [임시판 : 센서 없이 정해진 거리만 전진]
x_start = get_actual_tcp_pose()[0]
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start + (probe_dist) * 0.001
movel(tgt_pose, a = 1.2, v = v_seek)

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

    p_lx = get_actual_tcp_pose()[0]
    write_port_register(301, floor(p_lx * 10000 + 0.5))

    # 이 자리가 원점이다
    zero_pose = get_actual_tcp_pose()
    zero_inv = pose_inv(zero_pose)
    zero_ok = True
    
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start
movel(tgt_pose, a = 1.2, v = v_move)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v1/scripts_nosensor/dus_probe_l.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="5 [스크립트파일] dus_probe_r.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_probe_r.script — dusan_v1
#  Y- 끝으로 이동해 측정하고, 3점으로 벽면 2차식을 세운다
#
#  펜던트에서 &quot;5_probe_right&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

# 중앙 기준 Y- 너비의 절반 (지금 Y+ 끝에 있으므로 너비만큼 내려간다)
    tgt_pose = get_actual_tcp_pose()
    tgt_pose[1] = y_c - app_width * 0.0005
    movel(tgt_pose, a = 1.2, v = v_move)
    y_r = get_actual_tcp_pose()[1]
    
# Y- 끝 접근  [임시판 : 센서 없이 정해진 거리만 전진]
x_start = get_actual_tcp_pose()[0]
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start + (probe_dist) * 0.001
movel(tgt_pose, a = 1.2, v = v_seek)

n_probe = n_probe + 1
write_port_register(304, n_probe)
write_port_register(305, n_hit)

    p_rx = get_actual_tcp_pose()[0]
    write_port_register(302, floor(p_rx * 10000 + 0.5))
    
tgt_pose = get_actual_tcp_pose()
tgt_pose[0] = x_start
movel(tgt_pose, a = 1.2, v = v_move)


    # ---- 3점을 지나는 2차식.  dy = Y - y_c 일 때
    #        x(dy) = qa*dy*dy + qb*dy + qc
    #      dy=0 -&gt; p_cx,  dy=+half -&gt; p_lx,  dy=-half -&gt; p_rx
    half = app_width * 0.0005
    qc = p_cx
    qa = 0
    qb = 0
    if (half &gt; 0.0001):
      qa = (p_lx + p_rx - 2 * p_cx) / (2 * half * half)
      qb = (p_lx - p_rx) / (2 * half)
    end

    # 볼록량 = 중앙 - 양끝평균. 벽이 평면이면 0 에 가깝다
    write_port_register(303, floor((p_cx - (p_lx + p_rx) * 0.5) * 10000 + 0.5))
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v1/scripts_nosensor/dus_probe_r.script"/>
      </ScriptNode>
    </FolderNode>
    <FolderNode display="6 [스크립트파일] dus_goto_zero.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_goto_zero.script — dusan_v1
#  측정이 끝난 뒤 원점(Y+ 끝)으로 돌아가 스캔을 시작할 준비를 한다
#
#  펜던트에서 &quot;6_goto_zero&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def gz_w1(a, v):
      if (v &gt; 32000):
        v = 32000
      end
      if (v &lt; -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end


    def gz_w6(a, p):
      gz_w1(a, p[0] * 10000)
      gz_w1(a + 1, p[1] * 10000)
      gz_w1(a + 2, p[2] * 10000)
      gz_w1(a + 3, p[3] * 1000)
      gz_w1(a + 4, p[4] * 1000)
      gz_w1(a + 5, p[5] * 1000)
    end


    write_port_register(290, 3)

    # 먼저 Y 를 맞추고(벽에서 떨어진 상태로 이동), 그다음 X 로 접근한다
    tgt_pose = get_actual_tcp_pose()
    tgt_pose[1] = zero_pose[1]
    movel(tgt_pose, a = 1.2, v = v_move)

    tgt_pose = get_actual_tcp_pose()
    tgt_pose[0] = zero_pose[0]
    movel(tgt_pose, a = 1.2, v = v_move)

