<EliTask name="dusan_v1" installationName="dusan_v1" robotType="CS612" toolType="0" createdVersion="2.15.0.477" lastSavedVersion="2.16.0.964" robotSN="11111111111111" savedTime="2026-08-11 12:21:28" directory="Dusan/dusan_v1" installationDirectory="/Dusan/dusan_v1" typeName="로봇 메인 작업">
  <InitVariables typeName="변수 값 초기화"/>
  <MainTask isTaskAlwaysLoops="true" hasBeforeStart="false" hasInitVariables="true" typeName="로봇 메인 작업">
    <FolderNode display="1 [스크립트파일] dus_init.script" isHideSubtree="false" typeName="폴더">
      <ScriptNode scriptType="FILE_TYPE" typeName="스크립트">
        <cachedFileContents># =============================================================================
#  dus_init.script — dusan_v1
#  파라미터를 읽고 피치·행수를 계산한다. 실시간 발행 스레드를 띄운다
#
#  펜던트에서 &quot;1_init&quot; 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
#
#  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
#  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
#  ※ if / while 은 반드시 end 로 닫을 것
# =============================================================================

def ini_w1(a, v):
      if (v &gt; 32000):
        v = 32000
      end
      if (v &lt; -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end


    # 로봇 자체 레지스터 384~389 와 같은 단위.  길이 0.1mm, 회전 mRad
    def ini_w6(a, p):
      ini_w1(a, p[0] * 10000)
      ini_w1(a + 1, p[1] * 10000)
      ini_w1(a + 2, p[2] * 10000)
      ini_w1(a + 3, p[3] * 1000)
      ini_w1(a + 4, p[4] * 1000)
      ini_w1(a + 5, p[5] * 1000)
    end


    # 절대 TCP(260~265) 와 원점기준 상대좌표(280~285), alive(293) 발행
    def pub_rel():
      global cur_pose
      global rel_pose
      global alive
      cur_pose = get_actual_tcp_pose()
      ini_w6(260, cur_pose)
      if (zero_ok == True):
        rel_pose = pose_trans(zero_inv, cur_pose)
        ini_w6(280, rel_pose)
      end
      alive = alive + 1
      if (alive &gt; 30000):
        alive = 0
      end
      write_port_register(293, alive)
    end


    # 제어주기마다 도는 발행 스레드. 이 뒤로는 평범한 movel 을 써도
    # 이동 중 좌표가 계속 나간다.
    def pub_thread():
      while (True):
        pub_rel()
        sync()
      end
    end


    # ------------------------------------------------------------------ 본문
    # 266 = 1 이면 외부(Modbus)가 준 값을, 0 이면 펜던트 변수값을 쓴다
    if (read_port_register(266, True) == 1):
      app_width = read_port_register(256, True)
      app_height = read_port_register(257, True)
      scan_h = read_port_register(258, True)
      overlap = read_port_register(259, True)
    end

    if (app_width &lt;= 0):
      app_width = 1000
    end
    if (app_height &lt; 0):
      app_height = 0
    end
    if (scan_h &lt;= 0):
      scan_h = 200
    end
    if (overlap &lt; 0):
      overlap = 0
    end
    if (overlap &gt;= scan_h):
      overlap = scan_h - 10
    end

    # 상승 피치 = 스캐너 높이 - 겹침 (고정)
    pitch = scan_h - overlap
    if (pitch &lt;= 0):
      pitch = 10
    end

    # 스캐너가 한 자리에서 scan_h 를 훑으므로
    # 마지막 패스가 (높이 - scan_h) 이상이면 사각형 전체가 덮인다
    rows = ceil((app_height - scan_h) * 1.0 / pitch) + 1
    if (rows &lt; 1):
      rows = 1
    end
    if (rows &gt; 200):
      popup(s = &quot;ROWS OVER LIMIT(200). CHECK HEIGHT/SCAN_H/OVERLAP&quot;, title = &quot;dusan_v1&quot;, blocking = True)
      write_port_register(290, 9)
      halt()
    end

    row_idx = 0
    dir_sign = 1
    pass_done = 0
    path_len = 0
    alive = 0
    zero_ok = False
    n_probe = 0
    n_hit = 0
    qa = 0
    qb = 0
    qc = 0

    write_port_register(290, 0)
    write_port_register(291, 0)
    write_port_register(292, rows)
    write_port_register(293, 0)
    write_port_register(294, 0)
    write_port_register(295, 0)
    write_port_register(296, pitch)
    write_port_register(297, 0)
    write_port_register(298, 0)
    write_port_register(304, 0)
    write_port_register(305, 0)

    # 실시간 발행 스레드 기동
    pub_h = start_thread(pub_thread, (), detach_mode = True)
</cachedFileContents>
        <scriptFile pathRootType="TASK_PATH" path="Dusan/dusan_v1/scripts_nosensor/dus_init.script"/>
      </ScriptNode>
    </FolderNode>
