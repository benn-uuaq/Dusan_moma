# =============================================================================

def up_w1(a, v):
      if (v &gt; 32000):
        v = 32000
      end
      if (v &lt; -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end


    # 목표 높이는 직전 위치가 아니라 원점(z_base) 기준 절대값으로 잡는다.
    # 상대값으로 쌓으면 구간마다의 정지 오차가 행 수만큼 누적된다.
    tgt_pose = get_actual_tcp_pose()
    tgt_pose[2] = z_base + row_idx * pitch * 0.001
    movel(tgt_pose, a = 1.2, v = v_scan)

    path_len = path_len + pitch
    up_w1(297, path_len * 0.1)
