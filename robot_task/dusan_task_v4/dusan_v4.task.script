    # movej(get_inverse_kin(...))로 바꿨었는데, 좌우 이동은 movel(직선)로
    # 가도록 되돌린다.
    p_r_est = p_r_pose
    r_stand = pose_trans(p_r_est, [0, 0, -probe_dist * 0.001, 0, 0, 0])
    movel(r_stand, a = a_l, v = v_l)
