  <Variable name="zero_inv" value="[-0.60379, -0.19693, -0.51961, -1.57165, -1.25179, 0.00093]" remarks="pose_inv(zero_pose)" favorite="false"/>
  <Variable name="cur_pose" value="[0.68282, 0.41037, 0.19672, 1.57106, 0.00011, 1.25179]" remarks="현재 절대 TCP (260~265 로 발행)" favorite="false"/>
  <Variable name="rel_pose" value="[0.1, 0, 0.14004, 0, -0.00001, 0.00002]" remarks="원점 기준 상대 pose (280~285 로 발행)" favorite="false"/>
  <Variable name="tgt_pose" value="[0.59461, 0.40771, 0.33674, 1.57106, 0.00011, 1.18464]" remarks="현재 구간 목표 pose" favorite="false"/>
  <Variable name="dy" value="0.3" remarks="" favorite="false"/>
  <Variable name="y_from" value="-0.30001" remarks="" favorite="false"/>
