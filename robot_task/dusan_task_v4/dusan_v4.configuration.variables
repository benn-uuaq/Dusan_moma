  <Variable name="n_seg" value="12" remarks="" favorite="false"/>
  <Variable name="i_seg" value="13" remarks="" favorite="false"/>
  <Variable name="path_len" value="0" remarks="누적 이동거리 [mm]" favorite="false"/>
  <Variable name="alive" value="15917" remarks="워치독 카운터" favorite="false"/>
  <Variable name="mv_h" value="0" remarks="이동 스레드 핸들" favorite="false"/>
  <Variable name="pub_h" value="1764750432" remarks="발행 스레드 핸들" favorite="false"/>
  <Variable name="probe_rot" value="[0.53339, 0.05122, 0.19674, 1.57117, 0.00016, 1.61142]" remarks="정렬 전 기준 자세. 측정점 사이를 이동할 때 여기로 되돌린다 (probe_c 가 채운다)" favorite="false"/>
  <Variable name="arc_mode" value="1" remarks="movec 의 mode. 0 = 자세 고정" favorite="false"/>
  <Variable name="p_c_pose" value="[0.63307, 0.05527, 0.19672, 1.57106, 0.00012, 1.61146]" remarks="중앙 측정 pose — movec 의 경유점 (330~335 로 발행)" favorite="false"/>
  <Variable name="p_r_pose" value="[0.7115, -0.29461, 0.19672, 1.57106, 0.00012, 1.97113]" remarks="Y- 끝 측정 pose — movec 의 도착점 (340~345 로 발행)" favorite="false"/>
  <Variable name="via_pose" value="[0.63311, 0.05527, 0.33675, 1.57106, 0.00012, 1.61146]" remarks="movec 경유점 (현재 높이로 갈아끼운 것)" favorite="false"/>
  <Variable name="to_pose" value="[0.6946, 0.40771, 0.33675, 1.57106, 0.00012, 1.18463]" remarks="movec 도착점 (현재 높이로 갈아끼운 것)" favorite="false"/>
  <Variable name="z_now" value="0.33675" remarks="가로 패스 시작 시점의 Z [m]" favorite="false"/>
  <Variable name="home_tol_j" value="0.02" remarks="홈 위치로 보는 관절 오차 [rad]. 6축 중 가장 큰 차이가 이 값 이하면 홈으로 보고 레지스터 276 에 1 을 쓴다(약 1.1도)" favorite="false"/>
  <Variable name="home_tol_p" value="5" remarks="홈 위치로 보는 TCP 오차 [mm]. 관절이 달라도 TCP 가 Home_pose 에서 이 안쪽이면 홈으로 본다" favorite="false"/>
  <Variable name="veh_wait_cyc" value="15000" remarks="차량 고정(레지스터 309)을 기다리는 최대 제어주기 수. 125Hz 기준 약 120초. 넘으면 299=8 로 알리고 멈춘다" favorite="false"/>
  <Variable name="eoat5_offset" value="[0, 0, 0]" remarks="5축 십자형 EOAT 중심점 오프셋 [x, y, z] [mm] (툴 플랜지 로컬, +Z = 벽 방향). eoat_type=5 일 때 쓴다. 스캔 좌표(280~285, 286/287)에만 적용한다 — 홈·시작 자세·프로브·스캔 경로 같은 로봇 동작에는 쓰지 않는다" favorite="false"/>
  <Variable name="eoat8_offset" value="[0, 0, 0]" remarks="8축 직사각형 EOAT 중심점 오프셋 [x, y, z] [mm] (툴 플랜지 로컬, +Z = 벽 방향). eoat_type=8 일 때 쓴다. 스캔 좌표에만 적용한다 — 로봇 동작에는 쓰지 않는다" favorite="false"/>
  <Variable name="eoat_ofs" value="[0, 0, 0, 0, 0, 0]" remarks="[계산값] 지금 쓰는 EOAT 중심 오프셋 pose [m]. dus_init 이 eoat_type 으로 eoat5_offset / eoat8_offset 중 골라 만든다. 직접 바꾸지 말 것" favorite="false"/>
  <Variable name="push_offset" value="0" remarks="추가 누름 [mm]. 눌림 센서가 적정 눌림을 잡은 자리에서 TCP +Z 로 이만큼 더 민다(예: 5, 10). 프로브 3점(중앙·원점·끝)에 적용되고, 그 접점이 스캔 경로가 되므로 스캔 전체가 이만큼 더 눌린다. 0 이면 안 민다. 논센서판에는 적용하지 않는다" favorite="false"/>
  <Variable name="v_l_set" value="0.1" remarks="[기준값] movel(스캔 제외) 속도 [m/s]. dus_init 이 시작할 때마다 v_l 을 이 값(또는 레지스터 306)에서 다시 정한다. 운영 상한 100mm/s" favorite="false"/>
  <Variable name="v_j_set" value="0.34907" remarks="[기준값] movej 속도 [rad/s] (20 deg/s). dus_init 이 시작할 때마다 v_j 를 이 값에서 다시 정한다. 0.50 rad/s 상한" favorite="false"/>
  <Variable name="v_scan_set" value="0.1" remarks="[기준값] 스캔 속도 [m/s]. 고정 스펙 100mm/s. dus_init 이 시작할 때마다 v_scan 을 이 값에서 다시 정한다 (예전에는 v_scan 에 속도 비율을 곱해 셀마다 계속 느려졌다)" favorite="false"/>
  <Variable name="sig_hold" value="0.25" remarks="TPAC 동기 신호 대기 [s]. 스캔 줄 시작·끝에서 구간 레지스터(277)를 바꾼 뒤 이만큼 기다렸다가 움직인다 — RCS 브리지가 값을 읽고(100 ms) DO 신호를 50 ms 이상씩 순서대로 내보낼 시간이다. 줄이면 줄 앞부분이 펄스 없이 지나갈 수 있다" favorite="false"/>
</VariablesManager>