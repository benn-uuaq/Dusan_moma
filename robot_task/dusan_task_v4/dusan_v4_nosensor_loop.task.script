  pass_done = 1
  # 측정 완료한 점 수 (0~3)
  global n_probe
  n_probe = 3
  # 센서로 검출된 점 수
  global n_hit
  n_hit = 0
  # 중앙 측정 X [m]
  global p_cx
  p_cx = 0.63156
  # Y+ 끝 측정 X [m]
  global p_lx
