def dusan_v4_nosensor_loop():
  # Preamble Script.
  # Test Preamble Script To Be Added In The Future.
  set_safety_mode_transition_hardness(1)
  # Configuration Preamble Script.
  # Configuration variables.
  # 
  global Home_joint
  Home_joint = [0.66477, -1.58308, -2.73865, 1.18014, 0.90602, 0]
  # 
  global Home_pose
  Home_pose = [0.39874, 0, 0.38842, -1.5708, 0, -1.57081]
  # 그리퍼(EOAT)를 작업면 중앙에 딱 붙여 티칭한 pose (입력레지스터 316~321, UI가 저장한 값). 접촉 상태이지 대기 자세가 아니다 — 툴플렌지 pose도 아니다. dus_init이 eoat_type 오프셋을 빼 접촉 시점 플랜지 pose를 구한 뒤, probe_dist 만큼 TCP -Z로 물러난 곳을 start_pose로 계산한다
  global gripper_target_pose
  gripper_target_pose = [0.63171, -0.00005, 0.2687, -1.57143, -0.00019, -1.5708]
  # 실제 movej 목표(툴플랜지 기준, 그리퍼가 작업면에서 probe_dist 만큼 물러난 대기 자세). dus_init이 매 작업마다 gripper_target_pose 로부터 다시 계산한다 — 여기 직접 값을 넣어도 다음 작업 시작 시 덮어써진다
  global start_pose
  start_pose = [0.53171, -0.00005, 0.26876, -1.57143, -0.00019, -1.5708]
  # 0=이 변수값 사용, 1=Modbus 310~321 사용 (레지스터 308)
  global pose_src
  pose_src = 0
  # 발행 스레드 생존 확인용 — 워치독(293) 이전 값. dus_init 이 두 제어주기 동안 293 이 안 변하면 스레드가 죽은 것으로 보고 다시 띄운다
  global pub_a
  pub_a = 0
  # 발행 스레드 생존 확인용 — 워치독(293) 이후 값
  global pub_b
  pub_b = 2
  # 좌표 발행 스레드(pub_thread)를 이미 띄웠으면 1. dus_init 이 반복 실행돼도 스레드를 한 번만 띄우게 막는다 — 안 그러면 사이클마다 쌓여 Thread over the max size: 20 으로 멈춘다. 프로그램 시작 시 Init Variables Value 가 0 으로 되돌린다
  global pub_started
  pub_started = 1
  # 스캔 패스(dus_pass_r/l 의 movec) 진행 중이면 1. 이 구간에서만 제로점 기준 좌표(280~285)를 내보내고, 그 외에는 전부 0 을 쏜다. dus_init 이 시작할 때 0 으로 되돌린다
  global scan_on
  scan_on = 0
  # 장착된 그리퍼 종류. 0=없음(툴플랜지 그대로), 5=5축 십자형, 8=8축 직사각. 레지스터 264(param_src=1일 때, 레지스터 266)로 받거나 이 변수를 펜던트에서 직접 입력
  global eoat_type
  eoat_type = 5
  # 5축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 X [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat5_offset_x
  eoat5_offset_x = 0
  # 5축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 Y [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat5_offset_y
  eoat5_offset_y = 0
  # 5축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 Z [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat5_offset_z
  eoat5_offset_z = 0
  # 8축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 X [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat8_offset_x
  eoat8_offset_x = 0
  # 8축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 Y [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat8_offset_y
  eoat8_offset_y = 0
  # 8축 그리퍼: 툴플랜지 -> 그리퍼 기준점 오프셋 Z [m] (플랜지 로컬 좌표). 실측 후 채울 것
  global eoat8_offset_z
  eoat8_offset_z = 0
  # 작업 속도 입력 [mm/s] (입력레지스터 306). 0이면 v_l 유지
  global spd_in
  spd_in = 0
  # 로봇 자체 속도 비율 [%] 2~100 (입력레지스터 307)
  global spd_ratio
  spd_ratio = 100
  # 0=이 변수값 사용, 1=Modbus 256~259 사용 (레지스터 266)
  global param_src
  param_src = 0
  # 중앙 접촉 센서 1차 — ON 이면 적정 눌림 위치
  global di_touch
  di_touch = 0
  # 중앙 접촉 센서 2차 — ON 이면 눌림 한계. TCP -Z 로 후퇴한다
  global di_limit
  di_limit = 1
  # 도면 반지름(안쪽 면) [mm]. 레지스터 260 을 0.1mm 로 받고, dus_init 이 두께를 더해 훑는 면 반지름으로 바꾼다. 시험 벽 기준(MQTT 시뮬레이터·RCS 샘플과 동일) — 충돌 여유 700mm 현 계산도 이 반지름 기준
  global app_radius
  app_radius = 834.59998
  # 로봇이 실제로 훑는 바깥면의 반지름 [mm] = app_radius + app_thick. dus_init 이 매번 다시 계산한다. app_radius(도면 안쪽 반지름)에 두께를 덮어쓰면 dus_init 이 반복 실행될 때마다 두께가 또 더해져 값이 계속 커진다 — 그래서 따로 둔다
  global scan_radius
  scan_radius = 844.59998
  # 제품 두께 [mm]. 레지스터 261 을 0.1mm 단위로 받는다. UT 기록용
  global app_thick
  app_thick = 10
  # 격자 가로 = 호 길이 [mm] (레지스터 256). 로봇이 실제로 지나는 거리. 현이 아니다. 좌우 끝도 가운데 프로브 중심 기준이라 TCP 가 이 길이를 그대로 오간다. 좌우 끝점 사이 실제 현(app_width)이 충돌 여유 700mm 를 넘지 않는 최대 정수값(699.31mm)
  global app_arc
  app_arc = 721
  # 프로브 유효 가로 커버 [mm]. 레지스터 262. 5축 십자 30(가운데 프로브 지름) / 8축 직사각 75(좌우합). 경로에는 안 쓴다 — 좌우 끝도 프로브 중심 기준이다
  global eoat_w
  eoat_w = 30
  # 프로브 유효 세로 커버 [mm]. 레지스터 263. 5축 십자 30(가운데 프로브 지름) / 8축 직사각 167.5(상하합). scan_h 로 쓰이며 곧 up 동작의 최대 상승량이다
  global eoat_h
  eoat_h = 30
  # TCP 가 실제로 움직일 호 길이 [mm] = app_arc 그대로. dus_init 이 계산
  global arc_run
  arc_run = 721
  # 곡률 중심 X [m]. probe_l 이 계산
  global arc_ox
  arc_ox = 1.47616
  # 곡률 중심 Y [m]. probe_l 이 계산
  global arc_oy
  arc_oy = -0.00005
  # 원점(zero_pose)이 곡률 중심에서 보이는 각 [rad]
  global arc_phi0
  arc_phi0 = 2.71477
  # 호 기준이 잡혔는지. True 여야 호 위치를 발행한다
  global arc_ok
  arc_ok = True
  # 원점부터 지금까지의 호 위 거리 [mm]. 레지스터 286 으로 발행
  global arc_s
  arc_s = 721.01215
  # 호 반각 [rad] = arc_run/(2*app_radius). dus_init 이 계산
  global arc_half
  arc_half = 0.42683
  # 센서로 잰 적정 눌림 보정량 [m]. 계산한 3점을 TCP +Z 로 이만큼 더 민다
  global press_off
  press_off = 0.18755
  # 자세 보정 중 한 걸음 전진/후퇴 거리 [mm]
  global seek_step
  seek_step = 2
  # 전진·회전 되풀이 최대 횟수. 넘으면 포기하고 진행
  global seek_tries
  seek_tries = 80
  # 전진 최대 거리 [mm]. 센서가 없으면 여기까지 가고 멈춘다
  global seek_limit
  seek_limit = 400
  # 접근 전 대기 거리 [mm](TCP -Z로 물러난 지점, 거기서 TCP +Z로 전진해 접촉). probe_l/r/goto_zero 의 대기 지점과 start_pose(그리퍼가 작업면에 닿는 지점에서 물러나는 거리)가 전부 이 값을 같이 쓴다. 논센서판은 센서 없이 이만큼 전진하고 멈춘다
  global probe_dist
  probe_dist = 100
  # [임시판 전용] 중앙이 가장자리보다 더 전진할 거리 [mm]. 0 이면 app_diameter 로 자동 계산(바깥 볼록면이라 음수가 나온다). 손으로 넣으려면 0 이 아닌 값을 준다
  global probe_bow
  probe_bow = 0
  # [임시판 전용] 원통 지름 [mm]. probe_bow 가 0 일 때 호의 볼록량을 이 값으로 계산한다 (센서가 붙으면 필요 없다)
  global app_diameter
  app_diameter = 1669
  # 측정 후 후퇴 거리 [mm]
  global back_off
  back_off = 100
  # 가로 패스를 나누는 구간 길이 [mm]. 작을수록 X 보정이 촘촘하다
  global seg_len
  seg_len = 50
  # movel(스캔 제외) 블렌더 반경 [m]. probe_c에서 probe_l, probe_r로 이동할때에만 적용한다.
  global r_l
  r_l = 0.35
  # movel(스캔 제외) 속도 [m/s]. dus_init 이 150mm/s 로 상한을 자른다
  global v_l
  v_l = 0.15
  # movel(스캔 제외) 가속도 [m/s^2]. 필요하면 각 스크립트가 그 자리에서 바꿔 쓴다
  global a_l
  a_l = 1.2
  # movej 속도 [rad/s] (20 deg/s). dus_init 이 0.50 rad/s 로 상한을 자른다 — 조그 상한과 같다. 펜던트 MoveJ 노드(홈 복귀)는 이 값을 직접 참조하지 못하므로 노드 쪽 수치도 같이 맞춰 둬야 한다
  global v_j
  v_j = 0.34907
  # movej 가속도 [rad/s^2] (40 deg/s^2)
  global a_j
  a_j = 0.69813
  # 스캔 movel/movec 속도 [m/s]. 고정 스펙 100mm/s
  global v_scan
  v_scan = 0.1
  # 스캔 movel/movec 가속도 [m/s^2]. 고정 스펙 400mm/s^2
  global a_scan
  a_scan = 0.4
  # 적심(비비기) 진폭 [mm]. 스캔 직전 원점에서 호 안쪽으로 이만큼 갔다가 돌아온다. 물을 퍼뜨려 검사면을 적시는 동작
  global wet_amp
  wet_amp = 10
  # 적심 왕복 횟수. goto_zero 가 스캔 시작 직전에 돈다
