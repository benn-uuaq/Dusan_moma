  wet_cycles = 3
  # 적심 한 번의 이동량 [mm] (툴 로컬 X). wet_amp 에 방향 부호를 붙인 값 — goto_zero 가 p_c_pose 위치로 매번 다시 정한다
  global wet_step
  wet_step = 10
  # 적심 반복 카운터. goto_zero 가 쓴다
  global wet_i
  wet_i = 3
  # 원점 로컬에서 본 호 중앙(p_c_pose). X 성분 부호로 적심 방향을 정한다
  global wet_ref
  wet_ref = [0.34965, 0.00002, 0.07577, 0.00015, -0.42683, -0.00032]
  # 작업 영역 좌우 너비 [mm](= 좌우 끝점 사이 실제 현). 충돌 여유로 700mm 를 넘지 않게 app_arc 를 잡는다
  global app_width
  app_width = 699.30621
  # 작업 영역 높이 [mm] (입력레지스터 257)
  global app_height
  app_height = 500
  # 프로브 유효 세로 커버 [mm] (입력레지스터 258). 한 줄이 덮는 밴드 높이이자 up 동작의 최대 상승량
  global scan_h
  scan_h = 30
  # 격자 **안**의 줄 겹침 [mm] = scan_h - pitch. dus_init 이 계산해 넣는다. 입력레지스터 259 로 받는 값은 격자**끼리**의 겹침이라 뜻이 다르고, 격자 안 피치에는 쓰지 않는다
  global overlap
  overlap = 0.58824
  # 상승 피치 [mm]. 가운데 프로브가 밑면(0)과 윗면(app_height)을 모두 지나도록 app_height 를 균등 분할한 값 = app_height / gaps. dus_init 이 매번 다시 계산한다
  global pitch
  pitch = 29.41176
  # 줄 사이 간격 수 = ceil(app_height / scan_h). 줄 수는 여기에 1 을 더한 값이다
  global gaps
  gaps = 17
  # 가로 패스 수 = gaps + 1. 첫 줄은 ㅗ 자세로 밑면, 마지막 줄은 ㅜ 자세로 윗면을 가운데 프로브가 훑는다
  global rows
  rows = 18
  # 완료한 가로 패스 수
  global row_idx
  row_idx = 13
  # 1=오른쪽(Y-) 차례, -1=왼쪽(Y+) 차례
  global dir_sign
  dir_sign = -1
