    def nl_arc(mid, th):
      # 중앙 접점 mid 에서 호를 따라 th [rad] 만큼 돌아간 점(자세 포함).
      # 센서판(dus_probe_l)과 같은 계산이다.
      #
      # 원통은 세워져 있으므로 호는 **수평면** 안에 있다. 그래서
      #   (1) 곡률 중심 O 는 접점에서 '전진 방향(TCP +Z)의 **수평 성분**'으로 R.
      #   (2) 회전은 O 를 지나는 **수직축(베이스 Z)** 으로 한다.
      #       툴 로컬 Z 로 돌리면 호가 수평면을 벗어나 현이 짧아진다.
      # 자세도 같이 돌아가므로 각 점에서 손이 그 자리의 법선을 본다.
      if (scan_radius <= 0):
        return mid
      end
      fwd = pose_trans(mid, [0, 0, 1.0, 0, 0, 0])
      dx = fwd[0] - mid[0]
      dy = fwd[1] - mid[1]
      n = sqrt(dx * dx + dy * dy)
      if (n < 0.0001):
        return mid
      end
      r = scan_radius * 0.001
      o_t = [mid[0] + dx / n * r, mid[1] + dy / n * r, 0, 0, 0, 0]
      return pose_trans(o_t, pose_trans([0, 0, 0, 0, 0, th], pose_trans(pose_inv(o_t), mid)))
    end
    
    
    write_port_register(290, 3)
    
    # 양 끝을 계산해 베이스 Y 가 작은 쪽을 Y-(원점), 큰 쪽을 Y+ 로 나눈다.
    # 손이 어느 방향을 보느냐에 따라 +t 가 어느 쪽으로 갈지 달라지므로
    # 부호를 미리 못 박지 않고 실제 좌표로 가른다.
    # 호가 0 이면(반지름 0 또는 arc_run 0) nl_arc 가 중앙점을 그대로 돌려줘
    # 양 끝이 중앙과 겹친다. 그 상태로 진행하면 나중에 dus_pass_r 의 movec 이
    # "Target pose ... coincident with auxiliary pose" 로 죽는데, 그 문구만
    # 보고는 원인을 알 수 없다. 여기서 값을 짚어 멈춘다.
    if (scan_radius <= 0 or arc_half == 0):
      popup(s = "ARC IS ZERO: check radius(260) and arc length(256)",
            title = "dusan_v4", blocking = True)
      write_port_register(299, 4)
      write_port_register(290, 9)
      halt()
    end
    
    end_a = nl_arc(p_c_pose, arc_half)
    end_b = nl_arc(p_c_pose, -arc_half)
    # 반시계 방향으로 훑는다. 원점은 베이스 Y 가 **큰** 쪽 끝이고, 거기서
    # Y 가 줄어드는 방향으로 한 줄을 지난다. (예전에는 반대였다.) 발행 좌표는
    # dus_init 의 pub_rel 이 Rz 180 도로 뒤집으므로 Y 는 계속 + 로만 커진다.
    if (end_a[1] >= end_b[1]):
      zero_pose = end_a
      p_r_pose = end_b
    else:
      zero_pose = end_b
      p_r_pose = end_a
    end
    
    # 이 자리가 원점이자 movec 의 시작점이다 (회전값 포함)
    p_lx = zero_pose[0]
    write_port_register(301, floor(p_lx * 10000 + 0.5))
    zero_inv = pose_inv(zero_pose)
    zero_ok = True
    
    # ---- 호 위 위치를 실시간으로 내보내기 위한 기준 ---------------------------
    # TPAC 은 스캔 축 위치로 **호 길이**를 받아야 한다. 좌표를 그대로 주면
    # 현(1031.8)으로 7% 눌리고, 게다가 호 위치에 비례하지 않아 1/4·3/4 지점에서
    # 14.6mm 씩 어긋난다(C-scan 이 앞뒤로 밀려 찍힌다).
    # 곡률 중심과 원점의 방위각을 남겨 두면, 발행 스레드가 매 주기
    #   s = R * |현재각 - 원점각|
    # 으로 호 위 실제 거리를 계산할 수 있다.
    if (scan_radius > 0):
      fwd0 = pose_trans(p_c_pose, [0, 0, 1.0, 0, 0, 0])
      d0x = fwd0[0] - p_c_pose[0]
      d0y = fwd0[1] - p_c_pose[1]
      n0 = sqrt(d0x * d0x + d0y * d0y)
      if (n0 > 0.0001):
        arc_ox = p_c_pose[0] + d0x / n0 * scan_radius * 0.001
        arc_oy = p_c_pose[1] + d0y / n0 * scan_radius * 0.001
        arc_phi0 = atan2(zero_pose[1] - arc_oy, zero_pose[0] - arc_ox)
        arc_ok = True
      end
    end
    
    # 회전각이 다른 채로 벽 쪽 목표로 바로 가면 볼록한 곡면을 가로질러
    # 충돌한다. 목표 자세(zero_pose 의 회전) 그대로 뒤로 물러난 지점까지
    # 먼저 이동한 뒤, 그 자세로 곧장 전진해 들어간다.
    #
    # 여기 오기 전 위치(중앙, p_c_pose)에서 l_stand 까지는 호의 절반 가까이
    # 자세가 크게 돌아간다. 한때 movej(get_inverse_kin(...))로 바꿨었는데,
    # 좌우 이동은 movel(직선)로 가도록 되돌린다.
    l_stand = pose_trans(zero_pose, [0, 0, -probe_dist * 0.001, 0, 0, 0])
    movel(l_stand, a = a_l, v = v_l)
    # l_stand -> zero_pose 도 probe_dist 만큼밖에 안 되는 짧은 이동이지만,
    # 막 큰 자세 변화(movej)를 거친 직후라 그 근처는 여전히 movel 의 직선
    # 경로 역기구학이 빡빡할 수 있다(실제로 dus_probe_r.script 에서 발생).
    # 센서판과 달리 접촉을 눌림으로 찾는 게 아니라 계산값으로 바로 들어가는
    # 것뿐이라 직선일 필요가 없다 — 여기도 movej 로 바꾼다.
    movej(get_inverse_kin(zero_pose), a = a_j, v = v_j / 3.0)  # 접촉 위치 진입: 천천히
    
    n_probe = n_probe + 1
    write_port_register(304, n_probe)
    write_port_register(305, n_hit)
    
    # 다음 동작(probe_r)으로 넘어가기 전에 다시 물러난다 — 좌우 이동은
    # movel(직선)로 간다.
    movel(l_stand, a = a_l, v = v_l)
    $ LINE: (24, "2-1 move_start_waypoint")
    $ LINE: (25, "Script")
    # =============================================================================
    #  dus_move_start_waypoint.script — dusan_v4
    #  dus_move_start.script 와 같되 **블렌드 반경(r_l)** 을 걸고 지나간다
    #
    #  펜던트의 Waypoint(경유점) 기능 대신 쓰는 스크립트다. 마지막 movel 에
    #  r = r_l 을 주면 로봇이 start_pose 에 정확히 서지 않고 반경 r_l 안에서
    #  둥글게 스치며 다음 동작으로 이어진다 — 프로브 사이를 오갈 때 매번
    #  완전히 정지했다 다시 가속하는 것을 없애 사이클이 짧아진다.
    #
    #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
    #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
    #  ※ if / while 은 반드시 end 로 닫을 것
    #
    #  블렌드를 걸면 **그 자리에 정확히 서지 않는다**. 그래서 다음 동작이
    #  접촉 탐색(probe_c)처럼 시작점 정밀도를 요구하는 자리에는 쓰지 않고,
    #  프로브 사이 이동처럼 지나가기만 하면 되는 자리에만 쓴다.
    #  Z 올림(첫 movel)은 벽·바닥을 피하는 동작이라 블렌드를 걸지 않는다.
    if (get_actual_tcp_pose()[2] < start_pose[2] - 0.001):
      z_up = get_actual_tcp_pose()
      z_up[2] = start_pose[2]
      movel(z_up, a = a_l, v = v_l)
    end
    movel(start_pose, a = a_l, v = v_l, r = r_l)
    $ LINE: (26, "5 [스크립트파일] dus_probe_r.script")
    $ LINE: (27, "Script")
    # =============================================================================
    #  dus_probe_r.script — dusan_v4
    #  Y+ 끝으로 이동해 측정한다. 3점이 movec 의 시작/경유/도착이 된다
    #
    #  펜던트에서 "5_probe_right" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
    #
    #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
    #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
    #  ※ if / while 은 반드시 end 로 닫을 것
    # =============================================================================
    
    def pr_w1(a, v):
      if (v > 32000):
        v = 32000
      end
      if (v < -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end
    
    
    # 로봇 자체 레지스터 384~389 와 같은 단위.  길이 0.1mm, 회전 mRad
    def pr_w6(a, p):
      pr_w1(a, p[0] * 10000)
      pr_w1(a + 1, p[1] * 10000)
      pr_w1(a + 2, p[2] * 10000)
      pr_w1(a + 3, p[3] * 1000)
      pr_w1(a + 4, p[4] * 1000)
      pr_w1(a + 5, p[5] * 1000)
    end
    
    
    p_rx = p_r_pose[0]
    write_port_register(302, floor(p_rx * 10000 + 0.5))
    pr_w6(340, p_r_pose)
    
    # probe_l 과 같은 이유로, 뒤로 물러난 지점을 거쳐 목표 자세 그대로 전진한다.
    #
    # 지금 로봇은 dus_probe_l 이 끝낸 자리(Y- 끝)에 있고 r_stand 는 호 반대쪽
    # (Y+ 끝) 이라, 호 전체 폭만큼 자세가 크게 돌아간다. 한때
    # movej(get_inverse_kin(...))로 바꿨었는데, 좌우 이동은 movel(직선)로
    # 가도록 되돌린다.
    r_stand = pose_trans(p_r_pose, [0, 0, -probe_dist * 0.001, 0, 0, 0])
    movel(r_stand, a = a_l, v = v_l)
    # r_stand -> p_r_pose 도 probe_dist 만큼밖에 안 되는 짧은 이동이지만,
    # 막 큰 자세 변화(movej)를 거친 직후라 그 근처는 여전히 movel 의 직선
    # 경로 역기구학이 빡빡할 수 있다 — 실제로 여기서 "요청된 포즈에 도달할
    # 수 없음" 이 발생했다. 센서판과 달리 접촉을 눌림으로 찾는 게 아니라
    # 계산값으로 바로 들어가는 것뿐이라 직선일 필요가 없다 — movej 로 바꾼다.
    movej(get_inverse_kin(p_r_pose), a = a_j, v = v_j / 3.0)  # 접촉 위치 진입: 천천히
    
    n_probe = n_probe + 1
    write_port_register(304, n_probe)
    write_port_register(305, n_hit)
    
    # goto_zero 로 넘어가기 전에 다시 물러난다 — 좌우 이동은 movel(직선)로 간다.
    movel(r_stand, a = a_l, v = v_l)
    
    # 세 점이 그대로 movec 의 시작(원점) / 경유(중앙) / 도착(Y+ 끝) 이 된다.
    write_port_register(346, arc_mode)
    $ LINE: (28, "2-1 move_start_waypoint")
    $ LINE: (29, "Script")
    # =============================================================================
    #  dus_move_start_waypoint.script — dusan_v4
    #  dus_move_start.script 와 같되 **블렌드 반경(r_l)** 을 걸고 지나간다
    #
    #  펜던트의 Waypoint(경유점) 기능 대신 쓰는 스크립트다. 마지막 movel 에
    #  r = r_l 을 주면 로봇이 start_pose 에 정확히 서지 않고 반경 r_l 안에서
    #  둥글게 스치며 다음 동작으로 이어진다 — 프로브 사이를 오갈 때 매번
    #  완전히 정지했다 다시 가속하는 것을 없애 사이클이 짧아진다.
    #
    #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
    #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
    #  ※ if / while 은 반드시 end 로 닫을 것
    #
    #  블렌드를 걸면 **그 자리에 정확히 서지 않는다**. 그래서 다음 동작이
    #  접촉 탐색(probe_c)처럼 시작점 정밀도를 요구하는 자리에는 쓰지 않고,
    #  프로브 사이 이동처럼 지나가기만 하면 되는 자리에만 쓴다.
    #  Z 올림(첫 movel)은 벽·바닥을 피하는 동작이라 블렌드를 걸지 않는다.
    if (get_actual_tcp_pose()[2] < start_pose[2] - 0.001):
      z_up = get_actual_tcp_pose()
      z_up[2] = start_pose[2]
      movel(z_up, a = a_l, v = v_l)
    end
    movel(start_pose, a = a_l, v = v_l, r = r_l)
    $ LINE: (30, "6 [스크립트파일] dus_goto_zero.script")
    $ LINE: (31, "Script")
    # =============================================================================
    #  dus_goto_zero.script — dusan_v4
    #  측정이 끝난 뒤 원점(Y- 끝)으로 돌아가 스캔을 시작할 준비를 한다
    #
    #  펜던트에서 "6_goto_zero" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
    #
    #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
    #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
    #  ※ if / while 은 반드시 end 로 닫을 것
    # =============================================================================
    
    def gz_w1(a, v):
      if (v > 32000):
        v = 32000
      end
      if (v < -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end
    
    
    def gz_w6(a, p):
      gz_w1(a, p[0] * 10000)
      gz_w1(a + 1, p[1] * 10000)
      gz_w1(a + 2, p[2] * 10000)
      gz_w1(a + 3, p[3] * 1000)
      gz_w1(a + 4, p[4] * 1000)
      gz_w1(a + 5, p[5] * 1000)
    end
    
    
    write_port_register(290, 3)
    
    # 현재 TCP 자세를 기준으로 가면 안 된다 — 직전 지점(p_r_pose)의 회전이
    # 그대로 남아 있어 zero_pose 의 회전과 다르고, 그 채로 위치만 옮기면
    # 볼록한 곡면을 가로질러 충돌한다. probe_l/r 과 같은 방식으로, zero_pose
    # 자세 그대로 TCP 기준 -Z(뒤로) 물러난 지점까지 먼저 이동한 뒤
    # 그 자세로 +Z(전진)해 들어간다.
    #
    # 지금 로봇은 dus_probe_r 이 끝낸 자리(Y+ 끝)에 있고 z_stand 는 호 반대쪽
    # (원점, Y- 끝) 이라 호 전체 폭만큼 자세가 크게 돌아간다. 한때
    # movej(get_inverse_kin(...))로 바꿨었는데, 좌우 이동은 movel(직선)로
    # 가도록 되돌린다.
    z_stand = pose_trans(zero_pose, [0, 0, -probe_dist * 0.001, 0, 0, 0])
    movel(z_stand, a = a_l, v = v_l)
    # z_stand -> zero_pose 도 probe_dist 만큼밖에 안 되는 짧은 이동이지만,
    # 막 큰 자세 변화(movej)를 거친 직후라 그 근처는 여전히 movel 의 직선
    # 경로 역기구학이 빡빡할 수 있다(dus_probe_r.script 에서 실제로 발생).
    # 센서판과 달리 접촉을 눌림으로 찾는 게 아니라 계산값으로 바로 들어가는
    # 것뿐이라 직선일 필요가 없다 — movej 로 바꾼다.
    movej(get_inverse_kin(zero_pose), a = a_j, v = v_j / 3.0)  # 접촉 위치 진입: 천천히
    
    gz_w6(270, zero_pose)      # 원점 pose (스캔 중 변하지 않는다)
    write_port_register(294, 1)
    path_len = 0
    
    # ---- 원점 도착 : 진행 확인 -----------------------------------------------
    # 논센서판은 ERUT 와 주고받지 않는다. 대신 팝업으로 멈춰 서서 사람이
    # 프로브가 잘 붙었는지 보고 확인을 누르면 이어서 간다. 원 태스크는
    # 여기서 레지스터 267 로 ERUT 의 시작 신호를 기다린다.
    write_port_register(290, 7)
    popup(s = "AT ORIGIN. CHECK PROBES, THEN CONTINUE (WET -> SCAN)",
          title = "dusan_v4", blocking = True)
    
    # ---- 적심(비비기) ---------------------------------------------------------
    # 스캔 전에 검사면에 물을 퍼뜨린다. 원점에서 호 **안쪽**으로 조금 갔다가
    # 돌아오기를 wet_cycles 번 반복한다.
    #
    # 방향은 **툴 로컬 X** 다. 프로브는 로컬 +Z 로 벽에 다가가므로(probe_*
    # 스크립트가 전부 [0, 0, +-d] 로 전진·후퇴한다) 로컬 X/Y 는 벽면을 따라
    # 미끄러지는 축이고, 그중 X 가 호(좌우) 방향, Y 가 상하다. 베이스 Y 로
    # 밀면 안 된다 — 원점에서는 호가 arc_half 만큼 돌아 있어 그만큼 벽을
    # 파고들거나 뜬다.
    #
    # 부호는 호 중앙(p_c_pose)이 로컬에서 어느 쪽에 있는지로 정한다. 원점
    # 바깥으로는 나가지 않는다 — 작업 영역 끝이라 벽이 거기서 끝날 수 있다.
    # 10mm 를 직선으로 가도 곡면에서 벗어나는 양은 10^2/(2R) = 0.06mm 라
    # 무시할 수 있다.
    write_port_register(290, 8)
    # TODO: 여기에 물 분사 켜기를 넣는다. 비비기 전에 켜고 끝나면 끈다.
    #       (밸브 출력 배정되면 set_standard_digital_out(n, True/False) 로)
    wet_ref = pose_trans(pose_inv(zero_pose), p_c_pose)
    wet_step = wet_amp
    if (wet_ref[0] < 0):
      wet_step = -wet_amp
    end
    wet_i = 0
    while (wet_i < wet_cycles):
      movel(pose_trans(zero_pose, [wet_step * 0.001, 0, 0, 0, 0, 0]),
            a = a_scan, v = v_scan)
      movel(zero_pose, a = a_scan, v = v_scan)
      wet_i = wet_i + 1
    end
    # TODO: 여기서 물 분사 끄기.
    
    # 여기서부터 스캔 구간이다 — 호를 그리는 패스뿐 아니라 줄을 바꾸는
    # 상승(dus_up)까지 포함한다. 이 구간에서만 제로점 기준 좌표(280~285)가
    # 살아 있고(dus_init 의 pub_rel), RCS 도 state=6 으로 스캔 중을 안다.
    write_port_register(290, 6)
    $ LINE: (32, "Loop 200 times")
    Loop_1 = 0
    while (Loop_1 < 200):
      $ LINE: (33, "Script")
      pass_done=0
      $ LINE: (34, "If")
      if (row_idx<rows and dir_sign>0 and pass_done==0):
        $ LINE: (35, "7 [스크립트파일] dus_pass_r.script")
        $ LINE: (36, "Script")
        # =============================================================================
        #  dus_pass_r.script — dusan_v4
        #  원점에서 반대쪽 끝으로 한 줄. 중앙을 경유점으로 하는 movec 원호
        #
        #  펜던트에서 "7_pass_right" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
        #
        #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
        #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
        #  ※ if / while 은 반드시 end 로 닫을 것
        # =============================================================================
        
        def pr2_w1(a, v):
          if (v > 32000):
            v = 32000
          end
          if (v < -32000):
            v = -32000
          end
          write_port_register(a, floor(v + 0.5))
        end
        
        
        # 원점 -> p_r_pose 로 한 줄 — movec 원호 하나.
        # 반시계 방향으로 바뀌면서 베이스 Y 는 **줄어드는** 쪽이다.
        # 발행 좌표는 pub_rel 이 Rz 180 도로 뒤집어 + 로 내보낸다.
        # 스캔 동작에 들어섰다고 알린다(6 = 스캔 중). 이 값이 6 인 동안에만
        # 제로점 기준 좌표(280~285)가 나간다 — dus_init 의 pub_rel 참고.
        # 스캔 동작마다 세워 둬야, 사이클이 반복되며 goto_zero 를 다시 지나지
        # 않는 구성에서도 좌표가 끊기지 않는다.
        write_port_register(290, 6)
        
        z_now = get_actual_tcp_pose()[2]
        via_pose = p_c_pose.copy()
        via_pose[2] = z_now
        to_pose = p_r_pose.copy()
        to_pose[2] = z_now
        movec(via_pose, to_pose, a = a_scan, v = v_scan, r = 0, mode = 1)
        
        row_idx = row_idx + 1
        dir_sign = -1
        pass_done = 1
        # movec 는 호를 따라가므로 실제 지난 거리는 현이 아니라 호 길이다.
        # 총 작업 거리는 TCP 가 실제로 움직인 길이다. EOAT 폭만큼 짧으므로
        # 덮는 길이(app_arc)가 아니라 arc_run 을 더한다.
        path_len = path_len + arc_run
        write_port_register(291, row_idx)
        pr2_w1(297, path_len * 0.1)
        pr2_w1(298, row_idx * 100.0 / rows)
      end
      $ LINE: (37, "If")
      if (row_idx<rows and dir_sign<0 and pass_done==0):
        $ LINE: (38, "8 [스크립트파일] dus_pass_l.script")
        $ LINE: (39, "Script")
        # =============================================================================
        #  dus_pass_l.script — dusan_v4
        #  반대쪽 끝에서 원점으로 한 줄. 중앙을 경유점으로 하는 movec 원호
        #
        #  펜던트에서 "8_pass_left" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
        #
        #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
        #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
        #  ※ if / while 은 반드시 end 로 닫을 것
        # =============================================================================
        
        def pl2_w1(a, v):
          if (v > 32000):
            v = 32000
          end
          if (v < -32000):
            v = -32000
          end
          write_port_register(a, floor(v + 0.5))
        end
        
        
        # p_r_pose -> 원점 으로 한 줄 — movec 원호 하나.
        # 반시계 방향이라 베이스 Y 는 **늘어나는** 쪽이다.
        # 스캔 동작에 들어섰다고 알린다(6 = 스캔 중). 이 값이 6 인 동안에만
        # 제로점 기준 좌표(280~285)가 나간다 — dus_init 의 pub_rel 참고.
        # 스캔 동작마다 세워 둬야, 사이클이 반복되며 goto_zero 를 다시 지나지
        # 않는 구성에서도 좌표가 끊기지 않는다.
        write_port_register(290, 6)
        
        z_now = get_actual_tcp_pose()[2]
        via_pose = p_c_pose.copy()
        via_pose[2] = z_now
        to_pose = zero_pose.copy()
        to_pose[2] = z_now
        movec(via_pose, to_pose, a = a_scan, v = v_scan, r = 0, mode = 1)
        
        row_idx = row_idx + 1
        dir_sign = 1
        pass_done = 1
        # movec 는 호를 따라가므로 실제 지난 거리는 현이 아니라 호 길이다.
        # 총 작업 거리는 TCP 가 실제로 움직인 길이다. EOAT 폭만큼 짧으므로
        # 덮는 길이(app_arc)가 아니라 arc_run 을 더한다.
        path_len = path_len + arc_run
        write_port_register(291, row_idx)
        pl2_w1(297, path_len * 0.1)
        pl2_w1(298, row_idx * 100.0 / rows)
      end
      $ LINE: (40, "If")
      if (row_idx<rows):
        $ LINE: (41, "9 [스크립트파일] dus_up.script")
        $ LINE: (42, "Script")
        # =============================================================================
        #  dus_up.script — dusan_v4
        #  다음 줄로 한 피치만큼 상승한다
        #
        #  펜던트에서 "9_up" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
        #
        #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
        #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
        #  ※ if / while 은 반드시 end 로 닫을 것
        # =============================================================================
        
        def up_w1(a, v):
          if (v > 32000):
            v = 32000
          end
          if (v < -32000):
            v = -32000
          end
          write_port_register(a, floor(v + 0.5))
        end
        
        
        # 목표 높이는 직전 위치가 아니라 원점(z_base) 기준 절대값으로 잡는다.
        # 상대값으로 쌓으면 구간마다의 정지 오차가 행 수만큼 누적된다.
        # 스캔 동작에 들어섰다고 알린다(6 = 스캔 중). 이 값이 6 인 동안에만
        # 제로점 기준 좌표(280~285)가 나간다 — dus_init 의 pub_rel 참고.
        # 스캔 동작마다 세워 둬야, 사이클이 반복되며 goto_zero 를 다시 지나지
        # 않는 구성에서도 좌표가 끊기지 않는다.
        write_port_register(290, 6)
        
        tgt_pose = get_actual_tcp_pose()
        tgt_pose[2] = z_base + row_idx * pitch * 0.001
        movel(tgt_pose, a = a_scan, v = v_scan)
        
        path_len = path_len + pitch
        up_w1(297, path_len * 0.1)
      end
      $ LINE: (43, "If")
      if (row_idx>=rows):
