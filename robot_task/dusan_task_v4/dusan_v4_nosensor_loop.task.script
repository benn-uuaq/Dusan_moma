  y_r = -0.29815
  # 너비의 절반 [m]
  global half
  half = 0.3
  # 벽면 2차식 계수 : x = qa*dy^2 + qb*dy + qc, dy = Y - y_c
  global qa
  qa = 0
  # 벽면 2차식 1차항
