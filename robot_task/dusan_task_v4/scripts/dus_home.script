# =============================================================================
#  dus_home.script — dusan_v4
#  홈 높이만큼 먼저 올라간 뒤 moveJ 로 홈 자세로 간다
#
#  마킹 태스크의 마지막 노드. 펜던트의 move_home 노드와 같은 순서지만
#  스크립트로 두어 끝나고 상태를 알린다:
#    290 = 13  홈으로 가는 중
#    290 = 12  홈 도착 = 마킹 작업 끝 (RCS 가 이걸 보고 다음 점으로 간다)
#
#  ※ def main() 으로 감싸지 말 것
# =============================================================================
write_port_register(290, 13)
# 벽에 붙어 있을 수 있으니 먼저 TCP -Z 로 물러난다. 단 홈 자세보다 더
# 뒤로는 안 간다 — 홈이 TCP 축으로 뒤에 있는 만큼만, 최대 probe_dist.
# (RCS 의 홈 이동 명령과 같은 규칙이다.)
hm_cur = get_actual_tcp_pose()
hm_rel = pose_trans(pose_inv(hm_cur), Home_pose)
hm_back = -hm_rel[2]
if (hm_back > probe_dist * 0.001):
  hm_back = probe_dist * 0.001
end
if (hm_back > 0.001):
  movel(pose_trans(hm_cur, [0, 0, -hm_back, 0, 0, 0]), a = a_l, v = v_l)
end
if (get_actual_tcp_pose()[2] < Home_pose[2] - 0.001):
  hm_up = get_actual_tcp_pose()
  hm_up[2] = Home_pose[2]
  movel(hm_up, a = a_l, v = v_l)
end
movej(Home_joint, a = a_j, v = v_j)
write_port_register(290, 12)
