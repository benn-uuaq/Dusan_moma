  set_input_actions_to_default()
  set_gravity([0.0, 0.0, 9.82])
  # Frame variables.
  # Temporary frame variables.
  # Conveyor Config
  #--------------- lifting Column Function -----------------
  liftingColumn = rpc_factory("xmlrpc","http://0.0.0.0:9120/RPC2")
  def visualLimitLiftingColumn(visualMinLimit=0, visualMaxLimit=500):
      # 设置升降柱虚拟限位
      # visualMinLimit:虚拟最低限位
      # visualMaxLimit:虚拟最高限位
      liftingColumn.setVisualLimit(visualMinLimit, visualMaxLimit)
  def liftingCurrentHeight():
      # 获取升降柱当前高度
      return liftingColumn.currentHeight()
  def liftingStop():
      # 停止升降柱移动
      return liftingColumn.stop()
  def getLiftingTravel():
      # 获取升降柱总行程
      return 500
  def getLiftingMinLimit():
      # 获取升降柱最低限位
      return 0
  def getLiftingMaxLimit():
      # 获取升降柱最高限位
      return 500
  def connectLiftingColumn(ip, port=502, slaveID=1,length=500):
      # 链接升降柱
      # ip:升降柱ip
      # port:升降柱端口号
      # slaveID:从站ID
      # length:升降柱总行程
      liftingColumn.setLiftingLength(length)
      return liftingColumn.connect(ip, port, slaveID)
  def disConnectLiftingColumn():
      # 断开升降柱链接
      return liftingColumn.disConnect()
  def moveLiftingColumn(pos, speed, block=True):
      # 升降柱移动命令
      # pos: 升降柱位置
      # speed: 升降柱速度
      if pos > liftingColumn.getMaxLimit():
          popup(s="Move pos is over limit max.", title="LiftingColumnAdapter Plugin Error", blocking=True)
          halt()
      moveRes = liftingColumn.move(pos, speed)
      if not moveRes:
          popup("Lifting Column Failed To Move! Please Check Lifting Column Status!", title="LiftingColumnAdapter Plugin Error", error=True, blocking=True)
      while block:
          currentHeight = liftingColumn.currentHeight()
          errorCode = liftingColumn.errorCode()
          if currentHeight < pos + 2 and currentHeight > pos - 2 and currentHeight != -1:
              liftingColumn.clearMovingFlag()
              return True
          if errorCode > 0:
              liftingColumn.stop()
              liftingColumn.clearMovingFlag()
              popup(s="Lifting error ,stop task.Error code: " + str(errorCode), title="LiftingColumnAdapter Plugin Error", blocking=True)
              halt()
              return False
          sleep(0.2)
      return moveRes
  #--------------- lifting Column Function -----------------
  # Set Node Preamble Script.
  # Loop Node Preamble Script.
  # Waypoint Node Preamble Script.
  # Initial Variables value.
  global Loop_1
  def calculate_point_to_move_towards(frame, direction, position_distance):
    posDir = [direction[0], direction[1], direction[2]]
    if (norm(posDir) < 1e-6):
      return get_target_waypoint()
    end
    direction_vector_normalized = normalize(posDir)
    displacement_pose = [direction_vector_normalized[0] * position_distance,direction_vector_normalized[1] * position_distance,direction_vector_normalized[2] * position_distance,0,0,0]
    wanted_displacement_in_base_frame = pose_sub(pose_trans(frame, displacement_pose), frame)
    return pose_add(get_target_waypoint(), wanted_displacement_in_base_frame)
  end
  # Timer Node Preamble Script.
  # SubTask Node Preamble Script.
  # Before Start Preamble Script.
  # Thread Node Preamble Script.
  # Event Node Preamble Script.
  # Main Task Script.
  while (True):
    $ LINE: (2, "로봇 메인 작업")
    $ LINE: (3, "1 [스크립트파일] dus_init.script")
    $ LINE: (4, "스크립트")
    # =============================================================================
    #  dus_init.script — dusan_v3
    #  파라미터를 읽고 피치·행수를 계산한다. 실시간 발행 스레드를 띄운다
    #
    #  펜던트에서 "1_init" 자리에 스크립트 노드를 파일(File) 모드로 넣고 지정한다.
    #
    #  ※ def main() 으로 감싸지 말 것 (펜던트가 호출하지 않는다)
    #  ※ 최상위에 global 을 쓰지 말 것 (preamble 이 이미 선언·대입해 뒀다)
    #  ※ if / while 은 반드시 end 로 닫을 것
    # =============================================================================
    
    def ini_w1(a, v):
      if (v > 32000):
        v = 32000
      end
      if (v < -32000):
        v = -32000
      end
      write_port_register(a, floor(v + 0.5))
    end
    
    
    # 로봇 자체 레지스터 384~389 와 같은 단위.  길이 0.1mm, 회전 mRad
    def ini_w6(a, p):
      ini_w1(a, p[0] * 10000)
      ini_w1(a + 1, p[1] * 10000)
      ini_w1(a + 2, p[2] * 10000)
      ini_w1(a + 3, p[3] * 1000)
      ini_w1(a + 4, p[4] * 1000)
      ini_w1(a + 5, p[5] * 1000)
    end
    
    
    # 절대 TCP(260~265) 는 항상 발행한다. 원점기준 상대좌표(280~285)와 호
    # 위치(286/287)는 원점(zero_pose)이 잡혀 있으면(zero_ok/arc_ok) 항상
    # 내보낸다 — TPAC 의 "Plane" 이 실제 TCP 이동거리를 보여줘야 하므로 ㄹ자
    # 스캔 중(state=4)만이 아니라 3점측정 후 원점복귀·다음 줄 이동 중에도
    # 값이 살아 있어야 한다. 원점이 아직 없으면(zero_ok==False) [0,0,0,0,0,0]
    # 을 쏜다.
    #
    # 위치는 베이스 좌표계 그대로 빼서 쓴다(cur - zero). 원래는
    # pose_trans(zero_inv, cur_pose)로 툴 좌표계 기준값을 냈는데, 툴이
    # 벽을 비스듬히 보고 있으면 베이스 Z+ 로 올라가도 이 값의 Z 성분이
    # 음수로 커지는 문제가 있었다. register_map.txt 4항의 역변환 공식
    # base = R_zero * rel_tcp 은 rel_tcp = R_zero^T * (cur-zero) 이므로
    # 결국 cur - zero 와 정확히 같다(회전행렬을 걸었다 다시 푸는 셈).
    # 그러니 처음부터 베이스 좌표계로 빼면 회전행렬 없이 같은 결과이고,
    # 세로(Z)가 위로 갈수록 커지도록 직관과도 맞는다.
    def pub_rel():
      global cur_pose
      global rel_pose
      global alive
      cur_pose = get_actual_tcp_pose()
      ini_w6(260, cur_pose)
      if (zero_ok == True):
        rel_pose = [cur_pose[0] - zero_pose[0],
              cur_pose[1] - zero_pose[1],
              cur_pose[2] - zero_pose[2],
              cur_pose[3] - zero_pose[3],
              cur_pose[4] - zero_pose[4],
              cur_pose[5] - zero_pose[5]]
        ini_w6(280, rel_pose)
      else:
        ini_w6(280, [0, 0, 0, 0, 0, 0])
      end
      # ---- 호 위 위치 (TPAC 스캔 축) ----------------------------------
      # 좌표를 그대로 주면 현(1031.8)으로 7% 눌리고 호 위치에 비례하지도
      # 않는다. 원점부터 호를 따라 실제로 지난 거리를 계산해서 내보낸다.
      #   286 = 이번 줄의 호 위 거리 [0.1mm]  (0 ~ 11100)
      #   287 = 완료된 줄까지 더한 누적 [mm]
      if (arc_ok == True):
        adx = cur_pose[0] - arc_ox
        ady = cur_pose[1] - arc_oy
        aph = atan2(ady, adx) - arc_phi0
        # atan2 는 ±pi 로 감기므로 한 바퀴 보정한다
        if (aph > 3.14159265):
          aph = aph - 6.28318531
        end
        if (aph < -3.14159265):
          aph = aph + 6.28318531
