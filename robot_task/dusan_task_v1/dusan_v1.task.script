  #--------------- lifting Column Function -----------------
  liftingColumn = rpc_factory("xmlrpc","http://0.0.0.0:9120/RPC2")
  def visualLimitLiftingColumn(visualMinLimit=0, visualMaxLimit=500):
      # 设置升降柱虚拟限位
      # visualMinLimit:虚拟最低限位
      # visualMaxLimit:虚拟最高限位
      liftingColumn.setVisualLimit(visualMinLimit, visualMaxLimit)
  def liftingCurrentHeight():
      # 获取升降柱当前高度
      return liftingColumn.currentHeight()
  def liftingStop():
      # 停止升降柱移动
      return liftingColumn.stop()
  def getLiftingTravel():
      # 获取升降柱总行程
      return 500
  def getLiftingMinLimit():
      # 获取升降柱最低限位
      return 0
  def getLiftingMaxLimit():
      # 获取升降柱最高限位
      return 500
  def connectLiftingColumn(ip, port=502, slaveID=1,length=500):
      # 链接升降柱
      # ip:升降柱ip
      # port:升降柱端口号
      # slaveID:从站ID
      # length:升降柱总行程
      liftingColumn.setLiftingLength(length)
      return liftingColumn.connect(ip, port, slaveID)
  def disConnectLiftingColumn():
      # 断开升降柱链接
      return liftingColumn.disConnect()
  def moveLiftingColumn(pos, speed, block=True):
      # 升降柱移动命令
      # pos: 升降柱位置
      # speed: 升降柱速度
      if pos > liftingColumn.getMaxLimit():
          popup(s="Move pos is over limit max.", title="LiftingColumnAdapter Plugin Error", blocking=True)
          halt()
      moveRes = liftingColumn.move(pos, speed)
      if not moveRes:
          popup("Lifting Column Failed To Move! Please Check Lifting Column Status!", title="LiftingColumnAdapter Plugin Error", error=True, blocking=True)
      while block:
          currentHeight = liftingColumn.currentHeight()
          errorCode = liftingColumn.errorCode()
          if currentHeight < pos + 2 and currentHeight > pos - 2 and currentHeight != -1:
              liftingColumn.clearMovingFlag()
              return True
          if errorCode > 0:
              liftingColumn.stop()
              liftingColumn.clearMovingFlag()
              popup(s="Lifting error ,stop task.Error code: " + str(errorCode), title="LiftingColumnAdapter Plugin Error", blocking=True)
              halt()
              return False
          sleep(0.2)
      return moveRes
  #--------------- lifting Column Function -----------------
  # Set Node Preamble Script.
