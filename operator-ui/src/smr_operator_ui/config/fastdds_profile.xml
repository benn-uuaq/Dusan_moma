<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ROS 2 (Fast DDS) 전송 설정 — RCS 가 ROS 를 켜기 전에 FASTRTPS_DEFAULT_PROFILES_FILE 로 건다(2026-11-24).
  로봇 제어 노드 · AGV 제어 노드처럼 RCS 가 띄우는 노드도 물려받는다. 셸에서 이미 다른 파일을 걸었으면 그것을 쓴다.

  왜: WSL 미러 네트워크(networkingMode=mirrored)에서는 127.0.0.1 로 가는 UDP 가 loopback0 을 거치는데, 한 번에
  약 1.4 KB 를 넘는(IP 조각이 나는) 데이터그램은 사라진다. Fast DDS 는 같은 PC 의 노드끼리 127.0.0.1 로
  4 KB 남짓한 탐색(SEDP) 묶음을 보내므로 탐색이 끝나지 않아 RCS 가 로봇 · AGV 노드를 못 봤다
  (「연결 안 됨」, M2002 「로봇 Modbus 연결이 없습니다」). 한 데이터그램을 1400 B 로 줄이면 Fast DDS 가 RTPS 에서
  나눠 보내 IP 조각이 생기지 않는다. 같은 PC 의 실제 데이터는 공유 메모리(SHM)로 간다.
  다른 Linux PC 에서도 해가 없다(다른 PC 의 기본 설정 노드와도 그대로 통한다).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_1400</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>1400</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="smr_default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_1400</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
